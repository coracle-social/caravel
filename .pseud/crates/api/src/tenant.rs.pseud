module caravel_api::tenant  !net !db !fs !time !rand
  -- Routes for tenants managing their account, relays and invoices. Each loads what its path names
  -- and requires the caller to be its tenant or an admin, except the three Stripe links, which only
  -- the tenant may open.

  const MAX_IMPORT_SIZE = 1 GiB  -- the largest import body taken       @20
  pub data TenantView  -- a tenant as the API shows it: whether an NWC url is set, never the url  @25-37
    pubkey, return_url, stripe_customer_id: str
    nwc_is_set: bool
    nwc_error, stripe_error, stripe_payment_method_id: str?
    created_at: i64
    billing_anchor, churned_at, banned_at: i64?
  impl From for TenantView  -- copies the tenant, turning nwc_url into nwc_is_set  @39-55

  pub data CreateTenant { return_url }  -- the client's account page, where robot DMs link  @60-64
  pub async fn create_tenant(actor, body) -> TenantView fails  !net !db !time  @67-74
    -- POST /tenants: become a tenant, idempotently; an existing tenant comes back as it is.
  pub async fn get_tenant(actor, pubkey) -> TenantView fails  !db  -- GET /tenants/{pubkey}  @76-85
  pub data UpdateTenant { nwc_url? }                                    @88-90
  pub async fn update_tenant(actor, pubkey, body) -> TenantView fails  !db  @92-108
    -- PUT /tenants/{pubkey}: set the NWC url when one is given, then return the reloaded tenant.
  pub async fn list_tenant_relays(actor, pubkey) -> [Relay] fails  !db  @110-117
    -- GET /tenants/{pubkey}/relays
  pub async fn list_tenant_invoices(actor, pubkey) -> [Invoice] fails  !db  @119-126
    -- GET /tenants/{pubkey}/invoices
  pub async fn reconcile_tenant(actor, pubkey) -> TenantView fails  !net !db !time !rand  @130-141
    -- POST /tenants/{pubkey}/reconcile: bring billing up to date without charging, settling
    -- anything paid out of band.
  pub async fn get_draft_invoice(actor, pubkey) -> Invoice? fails  !db !time  @144-152
    -- GET /tenants/{pubkey}/invoices/draft: an unsaved invoice for what is owed so far this period.
  pub async fn list_draft_invoice_items(actor, pubkey) -> [InvoiceItem] fails  !db  @155-162
    -- GET /tenants/{pubkey}/invoices/draft/items: the outstanding items behind the draft.
  pub async fn create_stripe_session(actor, pubkey, return_url?) -> {url} fails  !net !db  @165-175
    -- GET /tenants/{pubkey}/stripe/session?return_url=: a Stripe billing portal; the tenant only.

  pub data CreateRelay { tenant_pubkey, ..settings: RelaySettings }     @180-184
  pub async fn create_relay(actor, body) -> Relay fails  !db !time !rand  @186-193
    -- POST /relays: create a relay for tenant_pubkey, which the caller is or administers; 201.
  pub async fn get_relay(actor, id) -> Relay fails  !db  -- GET /relays/{id}  @195-203
  pub async fn update_relay(actor, id, settings) -> Relay fails  !db !time !rand  @205-214
    -- PUT /relays/{id}: apply any of the settings; the core refuses a purged relay.
  pub async fn list_relay_memberships(actor, id) -> [Membership] fails  !db  @217-225
    -- GET /relays/{id}/memberships: its paid memberships, newest first.

  pub async fn get_payouts(actor, pubkey) -> PayoutStatus fails  !net !db  @230-238
    -- GET /tenants/{pubkey}/payouts: refreshed from Stripe, whether members can pay the tenant.
  pub async fn onboard_payouts(actor, pubkey, return_url?) -> {url} fails  !net !db  @242-254
    -- POST /tenants/{pubkey}/payouts/onboard: a Stripe onboarding link back to return_url, else
    -- the tenant's own return_url; the tenant only.
  pub async fn open_payouts_dashboard(actor, pubkey) -> {url} fails  !net !db  @257-265
    -- POST /tenants/{pubkey}/payouts/dashboard: a Stripe payouts login link; the tenant only.

  pub async fn add_relay_member(actor, id, pubkey) fails  !db !time     @268-277
    -- PUT /relays/{id}/members/{pubkey}: make a pubkey a member by hand; the core refuses a
    -- purged relay and a pubkey that isn't 64 hex.
  pub async fn remove_relay_member(actor, id, pubkey) fails  !db !time  @280-289
    -- DELETE /relays/{id}/members/{pubkey}: remove a member; the core refuses the owner and a
    -- purged relay.

  pub async fn list_relay_activity(actor, id) -> {activity} fails  !db  -- GET /relays/{id}/activity  @291-300
  pub async fn deactivate_relay(actor, id) fails  !db !time !rand  -- POST /relays/{id}/deactivate  @302-311
  pub async fn reactivate_relay(actor, id) fails  !db !time !rand  -- POST /relays/{id}/reactivate  @313-322
  pub async fn purge_relay(actor, id) fails  !db !time !rand            @325-334
    -- POST /relays/{id}/purge: delete its data for good and free its subdomain; the row stays.
  pub async fn erase_relay(actor, id) fails  !net !db !fs !time         @337-346
    -- POST /relays/{id}/erase: erase its events, media, rooms and access lists, keeping its settings.
  pub async fn export_relay_data(actor, id) -> Response fails  !db      @349-371
    -- GET /relays/{id}/export: an unpurged relay's events streamed as an application/x-ndjson
    -- attachment named <subdomain>.jsonl, outside the envelope.
  pub async fn import_relay_data(actor, id, body) -> ImportResult fails  !db !time  @375-394
    -- POST /relays/{id}/import: stream a JSONL body into an unpurged relay, reporting refused lines.
    413 import-too-large if the body claims more than MAX_IMPORT_SIZE
    otherwise read it through a limit, so a body that passes it breaks off there

  pub async fn get_invoice(actor, id) -> Invoice fails  !db  -- GET /invoices/{id}  @398-406
  pub async fn list_invoice_items(actor, id) -> [InvoiceItem] fails  !db  @408-416
    -- GET /invoices/{id}/items
