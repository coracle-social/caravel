module caravel_api::member  !net !db !time !rand
  -- The routes members use: memberships of relays that sell them, checkouts and renewals, and
  -- buying an invite, which needs no account.

  data MembershipView { status, current_period_end? }  -- a member's view of a membership  @17-20
  impl From for MembershipView                                          @22-29
  async fn load_selling_relay(core, id) -> Relay fails  !db             @32-37
    -- The relay if it charges members (a price, active and unpurged), else 404 relay not found.
  pub data ReconcileRequest { checkout }  -- the Stripe Checkout session a payer came back from  @41-43

  pub async fn get_account(actor) -> {pubkey, memberships} fails  !db   @46-62
    -- GET /account: every live membership the caller holds, each with its relay's offer.
  pub async fn get_offer(id) -> Offer fails  !db  -- GET /relays/{id}/offer, for anyone  @65-68
  pub async fn get_membership(actor, id) -> {membership?} fails  !db    @71-80
    -- GET /relays/{id}/membership: the caller's live membership of a selling relay, or null.
  pub async fn create_checkout(actor, id, return_url?) -> {url} fails  !net !db !time !rand  @83-94
    -- POST /relays/{id}/membership/checkout: a Stripe Checkout to join the relay or renew.
  pub async fn reconcile_checkout(actor, id, checkout) -> {paid} fails  !net !db !time  @97-110
    -- POST /relays/{id}/membership/reconcile: settle the caller's checkout, letting them in at
    -- once; 404 without a live membership, and the core refuses another membership's session.
  pub async fn cancel_renewal(actor, id) -> MembershipView fails  !net !db  @113-121
    -- POST /relays/{id}/membership/cancel: stop renewing; access lasts out the paid period.
  pub async fn create_invite(id, return_url?) -> {url} fails  !net !db !time !rand  @124-133
    -- POST /relays/{id}/invites: a Stripe Checkout buying an invite, for anyone.
  pub async fn get_invite(code) -> InviteView fails  !db  -- GET /invites/{code}, for its holder  @136-138
  pub async fn reconcile_invite(code, checkout) -> {paid} fails  !net !db !time  @142-152
    -- POST /invites/{code}/reconcile: settle the buyer's checkout so the invite works at once.
