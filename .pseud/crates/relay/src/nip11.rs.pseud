    -- SUPPORTED_NIPS, plus 29 with rooms, 86 with management and "9a" with push.
    -- With media also BUD-00, 01, 02, 04, 06 and 11.
  pub fn document(state, limits, transport) -> Value                    @37-77
    -- The relay's name, description, icon, tenant pubkey, own pubkey as "self", software and version.
    limitation: auth_required unless anonymous reads, restricted_writes unless public writes
