% source=crates/core/src/models/transfer.rs lang=rust lines=80 sha=a0633731e412

module caravel_core::models::transfer
  -- Moving a relay's events in and out as JSONL: what an import reports, what a dump line holds,
  -- and what it keeps of a room's history.

  pub const MAX_PROBLEMS = 100  -- problems reported one by one; past this only counted  @7-8
  pub data ImportProblem { line: usize?, event_id: str?, message }      @10-19
    -- A line, its event, or a room that didn't become a stored event; absent fields unserialized.
  pub data HistoryEntry { created_at: i64, kind: u16, id: [u8; 32] }    @21-28
    -- A stored room-history event, kept small until the room is rebuilt from it.
  pub data ImportResult                                                 @30-43
    -- What an import did; an event already held counts as imported, so reimports report the same.
    imported, invalid: usize
    skipped: usize  -- events describing the source relay's own state, which this relay writes
    rooms_rebuilt: usize
    problems: [ImportProblem]
    ~ skipped, rooms_rebuilt and problems are left out of JSON when empty
  fn is_zero(value) -> bool                                             @45-47

  impl ImportResult                                                     @49-71
    pub fn fail(mut self, problem)  -- count it invalid and note it     @50-53
    pub fn note(mut self, problem)  -- keep it only while under MAX_PROBLEMS  @55-59
    pub fn add(mut self, other)  -- sum other's counts and note its problems  @61-70

  pub enum Line  -- what one line of a dump holds                       @73-80
    Blank
    Invalid(ImportProblem)
    SourceState  -- an event describing the source relay's own state
    Event(Event)
