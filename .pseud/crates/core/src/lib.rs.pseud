module caravel_core
  -- Domain logic and persistence in layers: models, rules, queries, commands, and subsystems.

  pub data Core  -- what every core operation runs against              @51-68
    db: Db
    config: Config  -- shared by every clone
    clock: Clock
    bus: Bus
    stripe: Stripe
    robot: Robot
    wallet: Wallet  -- the platform's wallet, which issues the Lightning invoices tenants pay
    blobs: Blobs  -- where relays' media is stored
    livekit: Livekit?  -- the LiveKit server, when calls are set up
    outbound: Outbound  -- requests to urls other people chose: push callbacks and mirrored media

  impl Core                                                             @70-83
    pub fn with_db(self, db) -> Core  -- this core on another pool, so workers can't starve requests  @71-74
    pub fn relay_key(self, relay) -> RelayKey fails  -- relay.secret decrypted with the platform key  @76-82
