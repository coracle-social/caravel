# Server
PORT=2892
# The API's public base url, which NIP-98 signatures are checked against
API_URL=http://127.0.0.1:2892
# The dashboards' public url; unset, the binary serves none (`just dev` serves them with Vite)
PLATFORM_URL=
PLATFORM_NAME=Caravel
PLATFORM_LOGO=/caravel.png
ADMIN_PUBKEYS=

# Database (`just pg` starts one with podman)
DATABASE_URL=postgres://caravel:caravel@127.0.0.1:55433/caravel

# Robot identity, which is also the platform key secrets are encrypted with
ROBOT_SECRET=
ROBOT_NAME=
ROBOT_DESCRIPTION=
ROBOT_PICTURE=
ROBOT_WALLET=
ROBOT_OUTBOX_RELAYS=wss://relay.damus.io,wss://relay.primal.net,wss://nos.lol
ROBOT_INDEXER_RELAYS=wss://purplepag.es,wss://relay.damus.io,wss://indexer.coracle.social
ROBOT_MESSAGING_RELAYS=wss://auth.nostr1.com,wss://relay.keychat.io,wss://relay.ditto.pub

# Relays
RELAY_DOMAINS=spaces.coracle.social
# The header a trusted proxy reports clients' addresses in, such as X-Forwarded-For
FORWARDED_HEADER=
# New relay connections allowed per minute from one address; 0 is unlimited
CONNECTIONS_PER_MINUTE=0

# Calls, for relays with them on (all three, or none)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Media, kept in MEDIA_DIR unless a bucket is set
MEDIA_DIR=data/media
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_ENDPOINT=

# Billing
STRIPE_SECRET_KEY=
# The platform's cut of each membership payment, as a percent with at most two decimal places.
MEMBER_FEE_PERCENT=10
# Where invites are accepted.
FLOTILLA_URL=https://app.flotilla.social
