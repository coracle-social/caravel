% source=crates/core/src/models/memberships.rs lang=rust lines=84 sha=db00f66d10fe

module caravel_core::models::memberships
  -- Paid memberships: members paying a relay's tenant through Stripe Connect for access.

  pub enum MembershipStatus  -- stored lowercase                        @9-21
    Pending  -- a checkout was opened and hasn't been paid
    Active  -- paid for, and renewing
    Canceled  -- paid for until its period ends, and not renewing
    Lapsed  -- over, and history; paying again opens a new membership

  impl MembershipStatus                                                 @23-28
    pub fn is_paid(self) -> bool  -- Active or Canceled                 @24-27

  pub data Membership                                                   @30-51
    -- One member's paid access to one relay. Bought without a pubkey it is an invite:
    -- its code becomes a claim once paid, and it goes to the first pubkey without one that joins.
    id, relay_id: str
    pubkey: str?  -- the member; none for an invite nobody has used yet
    invite_code: str?  -- the code of a membership bought as an invite
    stripe_customer_id: str?  -- the customer it pays as, once a checkout opens
    stripe_subscription_id: str?  -- the subscription paying for it, once paid
    status: MembershipStatus
    current_period_end: i64?  -- when the period paid for ends
    bound_at: i64?  -- when an invite's membership was bound to the pubkey that joined with it
    created_at: i64

  impl Membership                                                       @53-61
    pub fn subscription(self) -> (customer_id, subscription_id) fails   @54-60
      -- Both Stripe ids of a paid membership; internal error when either is missing.

  pub data Offer  -- what anyone may see of a relay that sells memberships  @63-73
    relay: RelayProfile  -- flattened into the offer
    price: i64  -- cents per interval
    interval: MemberInterval
    accepting_payment: bool  -- the tenant can take payments now
  pub data InviteView                                                   @75-84
    -- What an invite's buyer sees.
    offer: Offer
    status: MembershipStatus
    bound: bool  -- bound to whoever joined with it
    invite_url: str?  -- the link that accepts it, while paid for and unbound
