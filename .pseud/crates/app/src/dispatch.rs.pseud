module caravel_app::dispatch
  -- Routing a request by its host to a relay, the API or the dashboards; any other host gets only
  -- the health check and the TLS ask, which answer on every host.

  pub data Hosts  -- the hosts the API and the dashboards are served on  @20-26
    api: str
    api_prefix: str  -- the path the API is served under, empty for the root
    platform: str?  -- the dashboards' host, if this process serves them
  impl Hosts                                                            @28-48
    pub fn from_urls(api_url, platform_url?) -> Hosts fails             @31-47
      -- Hosts and API path from the public urls; an API on the platform's host needs a path.

  data Dispatch { api: Router, relays, web, hosts }                     @51-56
  pub fn router(api, relays, web, hosts) -> Router  -- every request falls back to dispatch  @58-65

  async fn dispatch(dispatch, request) -> Response                      @67-93
    -- Route a request by its host, after the two paths every host answers.
    /healthz -> 200 ok; /domains/check -> the API, for on-demand TLS
    the API host -> the API, prefix stripped; on a shared platform host only paths under api_prefix
    the platform host -> platform_host
      both before relays' hosts, so no relay can take one over
    a host the relay registry resolves -> relay_host
    any other -> 404

  async fn relay_host(dispatch, route, request) -> Response             @97-120
    -- A relay's protocols, or its member portal for a browser.
    /assets/ paths -> the web apps' built file, else 404
    a page request on a host but the relay's primary one -> 308 to https://<primary><path and query>
    a page request on the primary host -> the portal shell carrying the relay's profile
    anything else -> relays.serve
  fn platform_host(dispatch, request) -> Response                       @124-142
    -- The dashboards: a built file at the path, else an app shell.
    other /assets/ paths -> 404; methods but GET and HEAD -> 405
    paths under /admin -> the admin shell; every other -> the tenant shell
  async fn call(router, request) -> Response  -- the request through router, which can't fail  @144-149
  fn is_under(path, prefix) -> bool  -- path is prefix or below it; all paths are under ""  @152-154
  fn strip_prefix(request, prefix) -> Request                           @157-178
    -- Drop prefix from a path under it, keeping the query and a leading slash; others pass as is.
  fn request_host(request) -> str                                       @182-195
    -- The Host header, else the HTTP/2 authority, lowercased without port or trailing dot.
