module caravel_core::tests::concurrency
  -- Races eight billing passes against one tenant: each write must still happen once.

  tests  !db                                                            @16-122
    const RACERS = 8                                                    @16
    async fn race_reconciles(core, tenant_pubkey) fails  !db  -- RACERS concurrent Settle passes  @18-25
    test racing_passes_bill_new_activity_once  -- one $5 invoice, anchor set, nothing left  @28-44
    test racing_passes_renew_once_and_invoice_once                      @47-70
      -- Two Basic relays renew in one $10 invoice with exactly two renewal items.
    test racing_passes_bill_overage_once  -- 3.2 GB peak bills $6 once on the renewal  @73-91
    test racing_passes_churn_once                                       @94-122
      -- Past grace, racing passes churn once: one MarkRelayDelinquent, the invoice voided.
