module caravel_core::ingest  !db !time
  -- Acting on what clients publish: storing events with their changes, and NIP-43 joins and leaves.

  pub async fn store(core, relay, key, rooms_enabled, event) -> (Saved, [Event]) fails  !db !time  @20-59
    -- Save an event and apply its change in one transaction; nothing goes on the bus.
    save the event; only a newly saved one changes anything
    match kind
      DELETION -> apply_deletion
      VANISH -> apply_vanish for its author, up to the event's created_at
      a room event, with rooms_enabled -> commands::rooms::apply_event, returning what it published
  pub async fn join(core, relay, key, event, join: Join) -> [Event] fails  !db !time  @63-76
    -- commands::memberships::admit_join in one transaction, which may bind a paid invite.
  pub async fn leave(core, relay, key, pubkey) -> [Event] fails  !db !time  @80-87
    -- commands::members::remove in one transaction; the owner can't leave.
