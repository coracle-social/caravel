    fn in_room(kind, pubkey, room) -> EventFacts                        @318-324
    test rooms_decide_who_sees_their_events                             @327-386
      -- As owner, member, outsider and anonymous: private rooms show outsiders only metadata,
      -- hidden rooms nothing; an uncreated room's posts reach only the owner but its deletion
      -- everyone; with groups off nothing is hidden.
    test a_count_includes_only_what_the_reader_may_see                  @389-417
      -- Counts apply the same visibility; invites are never counted, push subscriptions only
      -- for their author; anonymous counts as an outsider; any member key among several counts.
    test a_restricted_room_takes_posts_only_from_its_members            @420-481
      -- Outsiders may still request to join; closed rooms take posts; unknown rooms are "group not
      -- found"; only managers edit metadata or create rooms.
    test a_gift_wrap_or_zap_for_a_member_still_answers_to_its_room      @485-506
      -- An outsider's zap for a member lands in an open room, not a restricted, hidden or unknown one.
    test a_room_event_must_name_its_room                                @511-536
      -- Moderation kinds and join requests with no, empty or valueless h are "missing group id";
      -- so is a post with an empty h, while a post with no h is fine.
    test credentials_and_requests_are_never_served                      @539-561
      -- Invites, joins, leaves and Blossom auth go to nobody; a push subscription only to its author.
    test stripping_spares_whoever_manages_the_relay  -- and nothing strips when it's off  @564-575
    test ephemeral_kinds_are_not_stored                                 @578-582
    test relay_urls_name_their_host_without_scheme_port_or_path  -- lowercased, trailing dot dropped  @585-588
    test a_push_subscription_is_admitted_like_a_subscription            @593-610
      -- A stranger's is refused unless the relay is public_read; a member's is admitted.
    test a_push_subscription_may_name_any_of_the_relays_hosts  -- matched by url_host  @614-647
    test a_push_subscription_says_what_is_wrong_with_it                 @650-713
