module @/shared/lib/profiles  !net
  -- Reading Nostr profiles from the event store, fetched from each pubkey's outbox relays.

  pub fn profileName(profile?) -> str?  -- name, else display_name      @9-11
  pub fn useProfileMetadata(pubkey: () -> str?, opts { prime? }) -> signal ProfileContent?  !net  @13-36
    -- A pubkey's profile from the store, also fetched unless `prime` is false because a list does.
    cleared without a pubkey; the store subscription and fetch end when the pubkey changes
  pub fn useProfileMetadataMap(pubkeys) -> signal Map<pubkey, ProfileContent?>  !net  @38-60
    -- Several pubkeys' profiles, fetched in one request and each followed in the store.
  pub fn usePrimeProfiles(pubkeys)  !net  -- fetch a list's profiles at once, for its items to read  @62-70
  fn primeProfiles(pubkeys) -> Subscription  !net                       @72-103
    -- Fetch profiles from each pubkey's outbox relays into the event store.
    dedupe and drop empty pubkeys; nothing to fetch when none are left
    ask the relays already in the pool for the pubkeys' kind 10002 mailboxes  !net
    pick outboxes from the store's mailboxes, the pool's relays as fallback
      at most 8 connections and 3 relays per pubkey
    subscribe for kind 0 there, adding each event to the store  !net
