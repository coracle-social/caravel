% source=crates/app/src/config.rs lang=rust lines=171 sha=186a0261fa37

module caravel_app::config  !env
  -- Reading and checking the environment, the only place configuration comes from.

  pub data Settings  -- the core's config, plus what the app needs for the database and adapters  @12-23
    port: u16
    database_url, robot_wallet, stripe_secret_key: str
    config: Config
    robot_profile: RobotProfile
    media: Media
    livekit: Livekit?
    relays: RelaysConfig
    web: WebSettings
  pub data WebSettings  -- how the dashboards and the member portal are branded  @25-29
    platform_name, platform_logo: str
  pub enum Media = Local(dir) | S3(S3Config)  -- where relays' media is kept  @32-35
  pub data Livekit { url, api_key, api_secret }  -- the LiveKit server calls run on  @38-42

  pub fn load() -> Settings fails  !env                                 @44-114
    -- Read every variable, failing with a message naming the first one missing or malformed.
    ROBOT_SECRET must be a nostr secret key, and API_URL a url, kept without a trailing slash
    required: DATABASE_URL, ROBOT_WALLET, STRIPE_SECRET_KEY
    required lists: RELAY_DOMAINS, ROBOT_OUTBOX_RELAYS, ROBOT_INDEXER_RELAYS, ROBOT_MESSAGING_RELAYS
    optional: the ADMIN_PUBKEYS list, the robot's profile, FORWARDED_HEADER, PLATFORM_URL
      PLATFORM_URL goes in the core's config, kept without a trailing slash
    defaults: PORT 2892, FLOTILLA_URL https://app.flotilla.social, CONNECTIONS_PER_MINUTE 0 (none)
      PLATFORM_NAME Caravel, PLATFORM_LOGO /caravel.png, MEMBER_FEE_PERCENT 10 by parse_percent
    MEDIA_S3_BUCKET set -> S3, requiring its region, access key and secret key; endpoint optional
      otherwise a local MEDIA_DIR, by default data/media
    LIVEKIT_URL set -> LiveKit, requiring LIVEKIT_API_KEY and LIVEKIT_API_SECRET; otherwise no calls
  fn parse_percent(raw) -> f64?                                         @118-124
    -- 0 to 100 with at most two decimal places, which is what Stripe takes as an application fee.
  fn optional(key) -> str?  !env  -- the trimmed variable; None when unset or blank  @126-132
  fn required(key) -> str fails  !env  -- optional, failing "<key> is required"  @134-136
  fn list(key) -> [str]  !env  -- comma-separated, trimmed, blanks dropped; empty when unset  @138-145
  fn required_list(key) -> [str] fails  !env  -- list, failing "<key> is required" when empty  @147-153

  tests                                                                 @155-171
    ~ parse_percent takes 0, 10, 2.55 and 100, and refuses 2.555, 100.01, -1, NaN and words
