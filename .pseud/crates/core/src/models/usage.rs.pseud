% source=crates/core/src/models/usage.rs lang=rust lines=25 sha=6aeec8921e47

module caravel_core::models::usage
  -- Metered usage: hourly readings of paid relays' storage and call time, rolled up per period.

  pub data UsageSample                                                  @4-16
    -- One reading of a relay's metered usage.
    id, relay_id, tenant_pubkey: str
    storage_bytes: i64  -- a level, so a period bills its peak
    participant_seconds: i64  -- a lifetime clock, so a period bills its advance despite gaps
    created_at: i64
  pub data RelayUsageTotals { relay_id, peak_storage_bytes, participant_seconds }  @18-25
    -- One relay's usage over a closed period: peak storage, and how far its call clock advanced.
