    pub fn check(self, url) fails  -- parse url and check_url it under this client's rules  @160-162
    pub async fn post_json(self, url, body) -> u16 fails  !net          @165-176
      -- check_url, POST the JSON body, and return the status; the response body is never read.
    pub async fn fetch(self, url, max_size: u64) -> Fetched fails  !net  @179-210
      -- check_url, GET, and return the content type and body; fail on an error status.
      fail if Content-Length exceeds max_size
      stream the body, failing as soon as it grows past max_size

  tests                                                                 @213-257
    ~ internal IPv4 and IPv6 addresses are refused and public ones aren't
    ~ literal internal urls and non-http schemes fail check_url; allow_private lets loopback through
    ~ a name resolving to loopback is never dialed
