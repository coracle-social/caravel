module caravel_core::commands::ledger  !db !rand
  -- Writing the billing ledger: invoices, their items, and the payment attempts on them.

  pub async fn insert_invoice_for_outstanding_items(conn, tenant_pubkey, period, comped, now) -> Invoice? fails  !db !rand  @12-57
    -- Claim the tenant's outstanding items onto a new invoice for the period.
    total the tenant's unclaimed, unvoided items with get_outstanding_total
    return None if the total is at most 100 cents, which carries forward
      so a small credit can't drop an invoice under Stripe's $0.50 minimum
    insert the invoice for the total; a comped one is issued paid now with method Comp
    claim every unclaimed, unvoided item of the tenant onto it
    -- total-then-claim holds: callers lock the tenant, and an item insert's FK check waits on it
  pub async fn mark_invoice_paid(invoice_id, method: InvoiceMethod, now) fails  !db  @61-77
    -- Set method and paid_at only while the invoice is open, never on a voided or paid one.
  pub async fn mark_invoice_notified(invoice_id, now) fails  !db        @79-90
  pub async fn void_open_invoices_for_tenant(conn, tenant_pubkey, now) fails  !db  @94-119
    -- Forgive the tenant's balance so no credit or charge bleeds into a later invoice.
    void the tenant's open invoices
    then void every live item that is unclaimed or on an unpaid invoice
      after the invoices, so the ones just voided count as unpaid
  pub async fn insert_invoice_item(item: InvoiceItem) fails  !db        @121-140
