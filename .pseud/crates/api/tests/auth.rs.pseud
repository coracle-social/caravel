module caravel_api::tests::auth
  -- How the API authenticates: NIP-98-bought sessions, base-url signatures, which routes need them.

  tests                                                                 @12-319
    test a_signature_buys_a_session_until_it_is_deleted                 @13-28
      -- the bearer reads /identity as a non-admin until DELETE /session, then 401
    test a_session_signature_must_be_for_this_request_and_fresh         @31-51
      -- 401 for a signature over the base url, for GET, or two minutes early or late
    test a_session_expires_after_thirty_days                            @54-76
      -- good one second before thirty days, 401 at exactly thirty days
    test an_admin_can_revoke_every_session_a_pubkey_holds               @79-104
      -- the user gets 403 on DELETE /sessions/{pubkey}; the admin revokes both of its sessions
    test a_base_url_signature_works_for_fifteen_minutes                 @107-135
      -- accepted 14 minutes old, 401 at 16 minutes, and 401 for another host's url
    test every_route_has_an_auth_class                                  @140-267
      -- Every served route is in a class; public ones answer bare, the rest need credentials.
      every method and route the router serves matches a class entry, and every entry a route
      plans are 200 without credentials; domain check, offer, invites, invite reconcile are 404
      every tenant, relay, member, invoice and session route is 401 without credentials
      every admin route is 401 without credentials and 403 for a tenant's bearer
    async fn served_routes(api) -> [(method, route)]                    @271-292
      -- Each caravel_api::routes path's methods, but HEAD, from the Allow header of a 405 to PROBE.
    fn is_request_for(route, path) -> bool  -- same segments, ignoring the query; `{}` matches any  @295-303
    test banning_a_tenant_nobody_is_not_found                           @306-319
