module @/shared/lib/useRelayActions  !net !db !time
  -- What a relay's page can do to it, keeping the page's copy current and toasting failures.

  pub fn useRelayActions(relayId, relay, { refetch, mutate }) -> actions  !net !db !time  @7-71
    -- busy, toggle, updatePlan, and deactivate, reactivate, purge and erase through run.
    fn run(action, failure, success?)                                   @15-27
      skip while one runs; call action, refetch, and toast success if given, or the failure
    fn toggle(flag)  !net !db !time                                     @29-43
      flip the flag on the page's copy, PUT only that flag so other changes aren't undone, refetch
      on failure restore the copy and toast
    fn updatePlan(plan_id)  !net !db !time                              @45-60
      set the plan on the page's copy, turning blossom and livekit off for FREE; PUT it and refetch
      on failure restore the copy, toast, and rethrow
