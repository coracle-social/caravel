# Under `vite dev` there is no server writing configuration into each page, so
# the apps read these instead.

# Where `vite dev` proxies /api: the backend's PORT
VITE_API_TARGET=http://127.0.0.1:2892

# The domain new relays are created under: one of the backend's RELAY_DOMAINS
VITE_RELAY_DOMAIN=spaces.coracle.social

VITE_PLATFORM_NAME=Caravel

# A path under public/, or an absolute url
VITE_PLATFORM_LOGO=/caravel.png

# Where invites are accepted
VITE_FLOTILLA_URL=https://app.flotilla.social
