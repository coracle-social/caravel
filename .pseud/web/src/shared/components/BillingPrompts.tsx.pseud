module @/shared/components/BillingPrompts  !net !db !time
  -- The tenant dashboard's billing banner and the dialogs it opens.

  pub fn BillingPrompts()  !net !db !time                               @15-132
    -- The one prompt activeBillingPrompt picks, leaving out the invoice and autopay prompts while
    -- billingFlowActive. A `?invoice=<id>` link, as billing DMs send, opens that invoice's dialog.
    fetch the deep-linked invoice while the param is set, read through loaded  @23-31
    a failed deep-linked fetch toasts its error instead of opening the dialog  @33-35
    actions by prompt kind                                              @59-74
      churned -> "Update payment method", since churn voided the invoices to pay
      pay_invoice -> "Pay now" for the oldest open invoice
      update_method -> PaymentSetup on NWC if the wallet failed, else on the card
      setup_autopay -> "Set up autopay"; the only kind that can be dismissed, until the page reloads  @76-81
    closing the payment dialog clears the deep link when it came from one  @112-117
    closing either dialog runs autopay for the account, collecting what's owed and refetching  @87-91
