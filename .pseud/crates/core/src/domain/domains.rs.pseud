module caravel_core::domain::domains
  -- Custom domains: checking the ones tenants choose.

  global CUSTOM_DOMAIN_RE  !-panic !-global  -- compiled once, never mutated; the pattern is valid  @11-12
    exact                                                               @12
      LazyLock::new(|| Regex::new(r"^([a-z0-9][a-z0-9\-]*\.)+[a-z]{2,}$").unwrap());
  pub fn normalize_custom_domain(config, domain) -> str? fails          @14-46
    -- Trim, drop a trailing dot and lowercase; empty means none.
    fail invalid "invalid-domain" unless it matches CUSTOM_DOMAIN_RE
    fail invalid "reserved-domain" if it is a relay domain or under one, or is_platform_host
  pub fn is_platform_host(config, host) -> bool                         @49-53
    -- host is api_url's or platform_url's host, as url_host reads them.
