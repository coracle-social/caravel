module caravel_relay::connections  !lock
  -- What a relay keeps per connection: challenge, proved pubkeys, subscriptions, reconciliations.

  pub data Connections { inner: RwLock<Map<session_id, Connection>> }   @15-18
    -- One lock over every open connection of a relay; it all dies with the connection.
  data Connection                                                       @20-31
    session: Session
    challenge: str
    pubkeys: Set<str>  -- every pubkey proved, ordered; a client with several keys answers for each
    subscriptions: Map<SubscriptionId, [Filter]>
    reconciliations: Map<SubscriptionId, SyncSet>  -- own id space; each a snapshot taken at open
  pub enum RegisterError = TooMany | Gone  -- at the limit, or the connection closed meanwhile  @33-40
  pub data Match { session, subscription_id, pubkeys: [str] }           @42-47
    -- A live subscription an event matched, and the pubkeys it reads as.

  impl Connections  !lock                                               @49-205
    pub fn open(self, session, challenge)  -- register it with no pubkeys or subscriptions  @50-61
    pub fn close(self, session)  -- forget it                           @63-65
    pub fn challenge(self, session) -> str?                             @67-71
    pub fn pubkeys(self, session) -> [str]  -- proved pubkeys in order; empty until it authenticates  @73-79
    pub fn authenticate(self, session, pubkey, max) -> () fails RegisterError  @81-97
      -- Add a proved pubkey: Gone if closed, TooMany if it is new and max are held already.
    pub fn subscribe(self, session, subscription_id, filters, max) -> () fails RegisterError  @99-119
      -- Open or replace a subscription; only a new id counts against max.
    pub fn unsubscribe(self, session, subscription_id)                  @121-125
    pub fn open_reconciliation(self, session, subscription_id, set, max) -> () fails RegisterError  @127-146
      -- Open or replace a reconciliation; only a new id counts against max.
    pub fn reconciliation(self, session, subscription_id) -> SyncSet?   @148-158
    pub fn close_reconciliation(self, session, subscription_id)         @160-164
    pub fn matching(self, event) -> [Match]                             @166-185
      -- Every subscription with a matching filter, collected under the read lock, delivered outside it.
      -- tests every filter of every subscription on every connection, once per event
    pub fn sessions_for(self, pubkey) -> [Session]  -- connections authenticated as the pubkey  @187-194
    ~ read, write: the map's lock guards, recovering a poisoned lock    @196-204
