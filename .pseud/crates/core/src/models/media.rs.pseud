module caravel_core::models::media
  -- Blossom blobs, stored once per relay, owned by each uploader until the last one deletes it.

  pub const MAX_BLOB_SIZE: u64 = 10 MiB  -- the largest blob a relay takes  @7-8
  pub data Blob  -- a file a relay holds                                @10-22
    sha256: str
    content_type: str  -- the content type its first uploader gave it; "type" on the wire and in sql
    size: i64  -- bytes
    created_at: i64  -- first upload, or in one uploader's list, when they uploaded it
  pub enum Deleted  -- what deleting an upload did                      @24-33
    NotOwned  -- the pubkey owned no such blob
    Shared  -- others still own it, so its bytes stay
    Last  -- that was the last owner, so the blob went with it
