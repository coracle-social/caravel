module caravel_adapters::outbound  !net !time
  -- HTTP to urls other people chose, such as push callbacks and media, and connections to relays
  -- they chose, never to internal hosts.

  fn client(timeout, allow_private) -> reqwest::Client fails  !time     @18-35
    -- A client that resolves names itself and dials only addresses is_refused passes.
    -- So a name resolving somewhere else at request time (DNS rebinding) is still refused.
    no proxy, and PublicResolver as its resolver
    follow at most 5 redirects, each url passing check_url
  fn check_url(url, allow_private) fails                                @39-59
    -- http or https with a host; a literal IP, which resolution never sees, must pass is_refused.
  fn is_refused(ip) -> bool                                             @62-85
    -- Loopback, private, link-local, unspecified, multicast; also broadcast and CGNAT for IPv4.
    IPv4: the std predicates, plus 100.64.0.0/10
    IPv6: loopback, unspecified, multicast, fc00::/7, fe80::/10, and IPv4-mapped refused addresses
    exact                                                               @78-79
      || (ip.segments()[0] & 0xfe00) == 0xfc00
      || (ip.segments()[0] & 0xffc0) == 0xfe80
  data PublicResolver { allow_private: bool }                           @87-89
  impl Resolve for PublicResolver  !net                                 @91-108
    fn resolve(self, name) -> Resolving  !net                           @92-107
      -- The name's addresses that is_refused passes; an error when none do.
  pub(crate) async fn connect(url, allow_private) -> TcpStream fails  !net  @112-126
    -- A TCP connection to url's host and port (or its scheme's default) for protocols beside HTTP.
    -- Every host, a literal address included, goes through PublicResolver, so none refused is dialed.
  pub data Outbound { client, allow_private: bool }  -- the guarded client  @130-134
  pub data Fetched { content_type: str?, bytes: Bytes }                 @137-140

