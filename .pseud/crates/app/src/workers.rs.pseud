module caravel_app::workers  !net !db !fs !spawn !time !rand
  -- Background work: when each periodic job runs. The jobs themselves live in the core.

  const MINUTE = 60s                                                    @12
  const HOUR = 1h                                                       @13

  pub fn spawn(tracker, shutdown, core)  !net !db !fs !spawn !time !rand  @16-82
    -- Start every worker on core, each stopping when shutdown is cancelled.
    billing::reconcile_subscriptions at once, then hourly
    domains::verify_custom_domains at once, then every 30s
    domains::reverify_custom_domains after 3h, then every 3h
    sessions::sweep after an hour, then daily
    events::sweep_expired_events after a minute, then every minute
    memberships::sweep at once, then every 5m
    hosting::erase_purged_relays after a minute, then every 10m
    spawn publish_robot_identity
  fn every(tracker, shutdown, core, name, first, period, job)  !spawn !time  @85-115
    -- Run job after first, then every period, logging its failures.
    each run is awaited in the loop, so runs never overlap; a missed tick is delayed, not made up
    shutdown is noticed only between runs, so a running job finishes first
  async fn publish_robot_identity(core, shutdown)  !net !time           @119-134
    -- Publish the robot's profile and relay lists, retrying until it works, so a relay outage at
    -- startup doesn't hold up serving.
    after a failure wait 5s, doubling up to an hour; shutdown ends the wait
