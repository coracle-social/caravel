module caravel_core::queries::policy  !db
  -- Loading the snapshot a relay's rules are checked against.

  pub async fn load_snapshot(relay: Relay) -> RelaySnapshot fails  !db  @11-64
    -- The relay's settings with its members, method grants, bans and rooms.
    start from RelaySnapshot::of(relay)
    fill members, method grants, banned pubkeys and banned events from their queries
    add each room with its hidden, private, closed, livekit and restricted flags
    add each room member to its room, with its permitted kinds that fit a u16
    add each room invite code to its room
    -- each read is its own statement; callers pass the pool, so they aren't one consistent view
