module caravel_core::commands::media  !db
  -- Recording uploads to a relay and their deletion.

  pub async fn record_upload(conn, relay_id, sha256, content_type, size, pubkey, now) -> Blob fails  !db  @11-46
    -- Record an upload and its uploader as an owner, returning the blob as stored.
    insert the blob unless the relay has it, so the first upload's type and size stay
    insert the owner, doing nothing if it already owns it
    return the stored blob; fail internal if it is missing
  pub async fn delete_upload(conn, relay_id, sha256, pubkey) -> Deleted fails  !db  @49-84
    -- Take a pubkey's ownership of a blob away, removing the blob with its last owner.
    delete the pubkey's blob_owner row; return NotOwned if there was none
    delete the blob if no owner is left: Last if it went, else Shared
