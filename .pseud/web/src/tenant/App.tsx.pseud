module @/tenant/App
  -- The tenant dashboard's route table.

  pub fn App()                                                          @17-43
    -- One router rooted at Layout; requireTenant and TenantGate only decide what renders.
    / -> Home, open to everyone
    /relays, /relays/new, /relays/:id/edit and /account -> their pages behind requireTenant
    /relays/:id -> RelayFrame behind TenantGate, with a nested route per tab  @24-39
      "/" -> RelayDetail; members, rooms, rooms/:room, reports, content, bans -> their pages
