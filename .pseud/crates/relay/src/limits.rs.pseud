module caravel_relay::limits  !lock !time
  -- Per-address token buckets, limiting how often one client IP may connect.

  const MAX_TRACKED = 10_000  -- addresses held before refilled buckets are forgotten  @8-9
  pub data Limiter                                                      @11-17
    -- per_minute actions per address, bursting a minute's worth at once; zero is no limit.
    per_minute: u32
    buckets: Mutex<Buckets>
  data Buckets                                                          @19-25
    by_address: Map<IpAddr, Bucket>  -- keyed by client(ip)
    sweep_at: usize = MAX_TRACKED  -- twice what the last sweep kept, so sweeps stay rare
  data Bucket { tokens: f64, at: Instant }                              @27-31

  impl Limiter  !lock !time                                             @33-83
    pub fn new(per_minute) -> Limiter                                   @34-42
    pub fn allow(self, ip) -> bool  !lock !time  -- allow_at the monotonic now  @44-47
    fn allow_at(self, ip, now) -> bool  !lock                           @49-82
      -- Spend one token for client(ip), if it has one.
      allow anything when per_minute is zero
      under the lock, once sweep_at buckets are held, forget every bucket that has refilled
        then sweep next at twice what is left, and never below MAX_TRACKED
      a new address starts full; refill at per_minute/60 a second, capped at per_minute
      refuse below one token, else spend one

  fn client(ip) -> IpAddr                                               @85-92
    -- What a client is limited by: an IPv6 address's /64, which one subscriber usually holds
    -- whole, and an IPv4-mapped address as its IPv4 address.

  tests                                                                 @94-153
    ~ a burst spends a minute's worth and then refills; zero is no limit
    ~ IPv6 addresses in one /64 share a bucket; an IPv4-mapped address shares its IPv4 one
    ~ a sweep that frees nothing defers the next until the map doubles; refilled ones go then
