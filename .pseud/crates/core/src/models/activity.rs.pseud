module caravel_core::models::activity
  -- The relay activity log: each change billing prices, with the relay's plan and status then.

  pub enum ActivityType  -- stored and serialized snake_case            @9-20
    CreateRelay, UpdateRelay, ActivateRelay, DeactivateRelay, PurgeRelay
    MarkRelayDelinquent, UnmarkRelayDelinquent
  pub data Snapshot { plan_id, status: RelayStatus }  -- a relay's plan and status as of an activity  @22-27
  pub data Activity                                                     @29-39
    id, tenant_pubkey, relay_id: str
    created_at: i64
    activity_type: ActivityType
    billed_at: i64?  -- when billing reconciled it into the ledger; none before
    snapshot: Json<Snapshot>
