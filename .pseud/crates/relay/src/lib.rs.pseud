module caravel_relay  !net !db !global !lock !spawn !time
  -- Every live relay served from this process by host, loaded at start and reloaded on bus changes.

  pub data RelayLimits                                                  @42-54
    -- How much any one connection may ask of a relay.
    max_subscriptions: usize = 300
    max_identities: usize = 16  -- pubkeys proved on one connection
    max_reconciliations: usize = 8
    max_filters: usize = 200  -- filters one REQ or COUNT may hold, as strfry allows
    max_limit: usize = 1000  -- stored events one filter returns
    max_sync: usize = 20_000  -- events one reconciliation covers
  impl Default for RelayLimits  -- the defaults above                   @56-67

  pub data RelaysConfig                                                 @69-79
    -- How the relays are served.
    limits: RelayLimits
    transport: Transport
    forwarded_header: str?  -- a trusted proxy's client-address header; else the peer address
    connections_per_minute: u32  -- new connections per address; zero is unlimited

