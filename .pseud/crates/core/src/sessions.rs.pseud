module caravel_core::sessions  !db !time !rand
  -- Sessions: the bearer tokens a NIP-98 signature buys, good for thirty days.

  const TOUCH_INTERVAL = 1 hour                                         @9
  pub async fn start(core, pubkey) -> (token, Session) fails  !db !time !rand  @13-15
    -- Start a session, returning its bearer token; only the token's hash is stored.
  pub async fn find(core, token) -> Session? fails  !db !time           @19-30
    -- The live session for a token, touching last_used_at once it is TOUCH_INTERVAL stale.
  pub async fn end(core, token) fails  !db  -- delete the token's session  @33-35
  pub async fn revoke(core, pubkey) -> u64 fails  !db  -- delete every session pubkey holds  @38-40
  pub async fn sweep(core) -> u64 fails  !db !time  -- delete the expired sessions  @43-45
