module caravel_relay::tests::blossom
  -- Media over Blossom, ported from zooid: who may upload, list, fetch, delete; how blobs serve.

  tests  !panic                                                         @19-410
    fn sha256(bytes) -> str  -- hex digest                              @19-21
    fn blossom_auth(server, signer, verb, hashes) -> str                @24-38
      -- A kind 24242 authorization header for verb over hashes, expiring in a minute.
    async fn media_relay(server) -> (Relay, SecretKey)  -- a new relay on basic with media on  @40-46
    async fn upload(server, relay, signer, bytes, content_type) -> HttpResponse  !panic  @48-69
      -- PUT /upload under the relay's host, authorized for the bytes' hash.
    async fn download(server, relay, name) -> HttpResponse  !panic  -- unauthenticated GET /<name>  @71-80
    test a_member_uploads_and_anyone_downloads                          @83-110
      -- the descriptor carries sha256, size, type and `https://<host>/<sha>.png`
      the download is the bytes as image/png, nosniff, sandbox CSP, inline, and open to any origin
    test unrenderable_blobs_are_served_as_downloads                     @114-127
      -- text/html comes back as an attachment under the sandbox CSP
    test a_range_is_served_partially  -- bytes=2-5 is 206 with content-range 2-5/10  @130-148
    test outsiders_are_refused_with_a_reason                            @152-163
      -- a non-member's upload is 403 with x-reason unauthorized, exposed to browsers
    test a_delete_without_a_valid_authorization_is_refused              @167-187
      -- missing, non-base64 and empty-object authorizations are 401, and the blob stays
    test an_authorization_must_be_for_the_verb_and_unexpired            @190-243
      -- a delete authorization or an expired one is 401 for upload; one for another hash is 403
    test a_blob_stays_until_its_last_uploader_deletes_it                @246-299
      -- a member who never uploaded it gets 404 deleting; after the owner deletes it still serves
      after the second uploader deletes, it is 404
    test a_member_lists_an_uploaders_blobs  -- /list/<pubkey> returns the upload  @302-318
    test a_relay_may_keep_its_media_to_members                          @321-345
      -- with blossom_authenticated_read, a bare download is 401 and a member's get authorization 200
    test a_relay_without_media_has_no_media_server  -- upload is 404    @348-354
    test an_upload_is_checked_before_it_is_sent                         @357-377
      -- HEAD /upload with x-content-length: 1 KiB is 200, 11 MiB is 413
    test a_member_mirrors_a_file_from_another_server                    @380-410
      -- PUT /mirror fetches from a local server, keeps its content type, and then serves the bytes
