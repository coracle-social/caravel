  pub async fn list_moderation(Admin, window) -> ModerationPage fails  !db  @86-98
    -- GET /moderation?since=&until=: what every relay not owned by an admin saw in the seen_at
    -- window, newest first; page back by moving until, and items sharing a second can repeat.
  pub async fn get_moderation_blob(Admin, relay_id, sha256) -> Response fails  !db  @102-145
    -- GET /moderation/blob/{relay_id}/{sha256}: a blob's raw bytes, for members-only media.
    fail invalid-relay unless relay_id is non-empty and only ASCII letters, digits, _ and -
    fail invalid-sha256 unless sha256 is 64 hex
    404 unless the relay's blob row exists and the blob store still has its bytes
    stream it with its stored type, a private one-day immutable cache, nosniff and a sandbox CSP
