% source=crates/db/migrations/0001_init.sql lang=sql lines=408 sha=d8a53feb67b0

module caravel_db::migrations::0001_init  !db
  -- The squashed pre-release schema: tenants, relays, billing, sessions, events, access, media.
  -- Columns are NOT NULL unless `T?`; times are BIGINT seconds; every table but livekit_session
  -- has created_at; `-> t` references t.

  data tenant  !db                                                      @1-17
    pubkey: text pk; stripe_customer_id: text; return_url: text = ''
    nwc_url, nwc_error, stripe_error, stripe_payment_method_id, stripe_account_id: text?
    billing_anchor, renewed_at, overage_billed_at, churned_at, banned_at: time?
    stripe_account_ready: bool = false

  data relay  !db                                                       @19-69
    id: text pk; tenant_pubkey -> tenant; pubkey: text, unique as relay_pubkey_key
    subdomain, domain, plan_id, secret: text; status: text in (active, inactive, delinquent)
    info_name, info_icon, info_description: text = ''
    policy_public_read, policy_anonymous_read, policy_public_write, policy_public_join: bool = false
    policy_strip_signatures, blossom_enabled, livekit_enabled: bool = false
    groups_enabled, management_enabled, members_can_invite, push_enabled: bool = true
    custom_domain_verified, blossom_authenticated_read: bool = false
    custom_domain: text?; purged_at, erased_at: time?
    member_price: bigint = 0; member_interval: text = 'month', in (month, year)
    unique relay_subdomain_key (subdomain) where not purged  -- a purged relay's is free again  @53-54
    index relay_tenant_created_idx (tenant_pubkey, created_at)  -- dashboard and billing  @56-57
    unique relay_custom_domain_key (custom_domain) where verified, not purged  -- host lookup  @59-62
    index relay_unerased_idx (id) where purged but not erased  -- the erase sweep's queue  @64-65
    index relay_unverified_custom_domain_idx (id) where unverified, not purged  -- poller queue  @67-69

  data host_redirect  !db                                               @71-78
    host: text pk; relay_id -> relay
    index host_redirect_relay_idx (relay_id)  -- the hosts that redirect to one relay  @77-78

  data activity  !db                                                    @80-96
    id: text pk; seq: identity; tenant_pubkey -> tenant; relay_id -> relay
    activity_type: text; snapshot: jsonb; billed_at: time?
    index activity_relay_created_idx (relay_id, created_at, seq)  -- feed; state at a boundary  @91-93
    index activity_unbilled_idx (tenant_pubkey, created_at, seq) where unbilled  -- for billing  @95-96

  data invoice  !db                                                     @98-116
    id: text pk; seq: identity; tenant_pubkey -> tenant; method: text? in (nwc, stripe, oob, comp)
    amount, period_start, period_end: bigint; paid_at, voided_at, notified_at: time?
    index invoice_tenant_created_idx (tenant_pubkey, created_at, seq)  -- newest first  @112-113
    index invoice_open_idx (tenant_pubkey, created_at, seq) where unpaid, unvoided  -- dunning  @115-116

  data invoice_item  !db                                                @118-139
    id: text pk; seq: identity; invoice_id: -> invoice?; activity_id: -> activity?
    tenant_pubkey -> tenant; relay_id -> relay; plan_id: text; amount: bigint
    description: text = ''; voided_at: time?
    index invoice_item_invoice_idx (invoice_id)  -- the items on one invoice  @132-133
    index invoice_item_outstanding_idx (tenant_pubkey) where uninvoiced, unvoided  -- next invoice  @135-136
    unique invoice_item_activity_key (activity_id)  -- an activity is never billed twice  @138-139

  data bolt11  !db                                                      @141-152
    id: text pk; invoice_id -> invoice; lnbc: text; msats: bigint
    expires_at: time; settled_at: time?
    index bolt11_invoice_created_idx (invoice_id, created_at)  -- the latest Lightning invoice  @151-152

  data intent  !db                                                      @154-165
    id: text pk; invoice_id -> invoice; payment_method_id: text; payment_intent_id: text?
    settled_at: time?
    unique intent_unsettled_key (invoice_id) where unsettled  -- ensure_pending_intent's target  @163-165

  data checkout  !db                                                    @167-178
    id: text pk; invoice_id -> invoice; session_id, url: text; expires_at: time; settled_at: time?
    index checkout_invoice_created_idx (invoice_id, created_at)  -- latest and unsettled  @177-178

  data usage_sample  !db                                                @180-194
    id: text pk; relay_id -> relay; tenant_pubkey -> tenant
    storage_bytes, participant_seconds: bigint
    index usage_sample_tenant_created_idx (tenant_pubkey, created_at)  -- a period's rollup  @189-190
    index usage_sample_relay_created_idx (relay_id, created_at)  -- the baseline before a period  @192-194

  data session  !db                                                     @196-208
    token_hash: text pk; pubkey: text; expires_at, last_used_at: time
    index session_pubkey_idx (pubkey)  -- revoking every session a pubkey holds  @204-205
    index session_expires_idx (expires_at)  -- sweeping expired sessions  @207-208

  data event  !db                                                       @210-250
    pk (relay_id -> relay, id: bytea); seq: identity; kind: int; pubkey, sig: bytea
    content, tags: text; tag_values: text[]; d: text?; expires_at: time?; seen_at: time
    search: tsvector, generated from to_tsvector('simple', content)
    index event_relay_created_idx (relay_id, created_at desc, id)  -- every query's order  @228-229
    ~ by kind, by author, by both: event_relay_{kind,pubkey,kind_pubkey}_created_idx  @231-234
    gin event_tag_values_idx (tag_values)  -- tag queries; every write's tombstone check  @236-237
    gin event_search_idx (search)  -- NIP-50 full-text search           @239-240
    index event_seen_idx (seen_at desc, seq desc)  -- moderation feed across relays  @242-243
    unique event_slot_key (relay_id, kind, pubkey, d) where d is set  -- replaceable slots  @245-247
    index event_expires_idx (expires_at) where set  -- the NIP-40 sweep  @249-250

  data relay_member  !db                                                @252-262
    pk (relay_id -> relay, pubkey); roles: text[] = '{}'
    source: text in (owner, manual, claim, public_join, payment, migrated)
    index relay_member_pubkey_idx (pubkey)  -- the relays a pubkey belongs to  @261-262
  data role  !db                                                        @264-273
    pk (relay_id -> relay, id); label, description: text = ''; hue, position: int = 0
  data method_grant  !db                                                @275-282
    pk (relay_id, pubkey, method); (relay_id, pubkey) -> relay_member, on delete cascade
  data banned_pubkey { pk (relay_id -> relay, pubkey), reason: text = '' }  !db  @284-290
  data banned_event { pk (relay_id -> relay, event_id: text), reason: text = '' }  !db  @292-298
  data claim { pk (relay_id -> relay, code), revoked_at: time? }  !db   @300-306

  data room { pk (relay_id -> relay, id: text, not ''), tags, pins: jsonb = '[]' }  !db  @308-315
  data room_member  !db                                                 @317-326
    pk (relay_id, room_id, pubkey); (relay_id, room_id) -> room, on delete cascade
    roles: text[] = '{}'; permissions: int[] = '{}'
  data room_invite  !db                                                 @328-335
    pk (relay_id, room_id, code); (relay_id, room_id) -> room, on delete cascade

  data blob { pk (relay_id -> relay, sha256), type: text, size: bigint }  !db  @337-344
  data blob_owner  !db                                                  @346-359
    pk (relay_id, blob_sha256, pubkey); (relay_id, blob_sha256) -> blob, on delete cascade
    index blob_owner_pubkey_idx (relay_id, pubkey, created_at)  -- BUD-02 lists  @355-356
    index blob_owner_created_idx (created_at desc)  -- moderation feed across relays  @358-359
  data livekit_session  !db                                             @361-368
    pk (relay_id -> relay, sid); room_id: text; seconds: bigint; ended_at: time
  data notification  !db                                                @370-377
    pk (relay_id -> relay, pubkey); message: text; expires_at: time?

  data membership  !db                                                  @379-408
    id: text pk; relay_id -> relay; pubkey, invite_code: text?, at least one set
    stripe_customer_id, stripe_subscription_id: text?; current_period_end, bound_at: time?
    status: text in (pending, active, canceled, lapsed)
    unique membership_live_key (relay_id, pubkey) where not lapsed, pubkey set  -- a lapse frees it  @393-396
    unique membership_invite_key (invite_code) where set  -- invite pages and joins  @398-399
    index membership_relay_idx (relay_id, created_at)  -- memberships; invites holding seats  @401-402
    index membership_pubkey_idx (pubkey) where set  -- a member's account  @404-405
    index membership_live_idx (current_period_end) where not lapsed  -- the sweep's queue  @407-408
