module caravel_core::models::events
  -- The event store's shapes: every relay's events in one table, deletions kept as tombstones.

  pub data EventHead { id, pubkey: [u8; 32], created_at, kind: u16, tag_values: [str] }  @7-16
    -- What a relay's policy reads about an event without its content; tags as name:value.
  pub data EventGroup { kind, pubkey, d: str?, h: str?, count }         @18-27
    -- Events alike in all the rules read: kind, author, and first d and h tags (its room).
  pub data StoredEvent { head, content, tags, sig }  -- tags as the JSON it was signed with  @29-36
  pub data EventPage  -- a page of a relay's events for a dashboard, newest first, ties by id  @38-54
    kinds: [u16], ids: [str]  -- only these, unless empty
    until: i64?  -- created at or before
    after: str?  -- with until, skip events at until whose id doesn't sort after this
    exclude_own: bool  -- leave out what the relay signed itself
    limit: usize
  pub enum Saved  -- what saving an event did                           @56-65
    New  -- the event is new here
    Duplicate  -- the relay already has it, or a newer version of its slot
    Deleted  -- a stored deletion or vanish request refuses it

  impl EventHead                                                        @67-93
    ~ from_event, id_hex, pubkey_hex                                    @68-84
    pub fn tag(self, name) -> str?  -- the first value of a single-letter tag  @86-92

  impl StoredEvent                                                      @95-128
    pub fn from_event(event) -> StoredEvent  !-panic  -- tags always serialize  @96-103
    pub fn to_json(self, strip_signature: bool) -> str  !-panic         @105-123
      -- NIP-01 JSON built by hand from the stored tags JSON, without sig when stripping.
    pub fn to_event(self) -> Event fails  -- the event, parsed back from its to_json  @125-128

  fn tag_values(event) -> [str]  -- name:value for tags with a value and a one-character name  @131-139
