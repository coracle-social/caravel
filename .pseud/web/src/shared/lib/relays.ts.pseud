module @/shared/lib/relays  !net !db !time
  -- Relay resources for the dashboards, and creating a relay for the signed-in tenant.

  pub fn useTenantRelays()  !net !db !time  -- resource of the signed-in tenant's relays  @7
  pub fn useRelay(relayId)  !net !db !time  -- resource of a relay, refetched when the id changes  @9
  pub fn useRelayActivity(relayId)  !net !db !time  -- resource of a relay's activity  @11-14
  pub fn useRelayMembers(relayId)  !net !db !time  -- resource of a relay's members; [] with no id or on failure  @16-25
  pub fn createRelayForActiveTenant(input) -> Relay  !net !db !time     @27-51
    -- Create a relay for the signed-in tenant under RELAY_DOMAIN.
    defaults: empty info, every policy 0, groups, management, member invites and push on
    input overrides the defaults
    tenant_pubkey, zooid_domain, and blossom and livekit (off only on FREE) override the input
