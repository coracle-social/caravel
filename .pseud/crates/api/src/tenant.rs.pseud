module caravel_api::tenant  !net !db !fs !time !rand
  -- Routes for tenants managing their account, relays and invoices. Each loads what its path names
  -- and requires the caller to be its tenant or an admin, except the three Stripe links, which only
  -- the tenant may open.

  const MAX_IMPORT_SIZE = 1 GiB  -- the largest import body taken       @21
  pub data TenantView  -- a tenant as the API shows it: whether an NWC url is set, never the url  @26-38
    pubkey, return_url, stripe_customer_id: str
    nwc_is_set: bool
    nwc_error, stripe_error, stripe_payment_method_id: str?
    created_at: i64
    billing_anchor, churned_at, banned_at: i64?
  impl From for TenantView  -- copies the tenant, turning nwc_url into nwc_is_set  @40-56

  pub data CreateTenant { return_url }  -- the client's account page, where robot DMs link  @61-65
  pub async fn create_tenant(actor, body) -> TenantView fails  !net !db !time  @68-75
    -- POST /tenants: become a tenant, idempotently; an existing tenant comes back as it is.
  pub async fn get_tenant(actor, pubkey) -> TenantView fails  !db  -- GET /tenants/{pubkey}  @77-86
  pub data UpdateTenant { nwc_url? }                                    @89-91
  pub async fn update_tenant(actor, pubkey, body) -> TenantView fails  !db  @93-109
    -- PUT /tenants/{pubkey}: set the NWC url when one is given, then return the reloaded tenant.
  pub async fn list_tenant_relays(actor, pubkey) -> [Relay] fails  !db  @111-118
    -- GET /tenants/{pubkey}/relays
  pub async fn list_tenant_invoices(actor, pubkey) -> [Invoice] fails  !db  @120-127
    -- GET /tenants/{pubkey}/invoices
  pub async fn reconcile_tenant(actor, pubkey) -> TenantView fails  !net !db !time !rand  @131-142
    -- POST /tenants/{pubkey}/reconcile: bring billing up to date without charging, settling
    -- anything paid out of band.
  pub async fn get_draft_invoice(actor, pubkey) -> Invoice? fails  !db !time  @145-153
    -- GET /tenants/{pubkey}/invoices/draft: an unsaved invoice for what is owed so far this period.
  pub async fn list_draft_invoice_items(actor, pubkey) -> [InvoiceItem] fails  !db  @156-163
    -- GET /tenants/{pubkey}/invoices/draft/items: the outstanding items behind the draft.
  pub async fn create_stripe_session(actor, pubkey, return_url?) -> {url} fails  !net !db  @166-176
    -- GET /tenants/{pubkey}/stripe/session?return_url=: a Stripe billing portal; the tenant only.

  pub data CreateRelay { tenant_pubkey, ..settings: RelaySettings }     @181-185
  pub async fn create_relay(actor, body) -> Relay fails  !db !time !rand  @187-194
    -- POST /relays: create a relay for tenant_pubkey, which the caller is or administers; 201.
  pub async fn get_relay(actor, id) -> Relay fails  !db  -- GET /relays/{id}  @196-204
  pub async fn update_relay(actor, id, settings) -> Relay fails  !db !time !rand  @206-215
    -- PUT /relays/{id}: apply any of the settings; the core refuses a purged relay.
  pub async fn list_relay_memberships(actor, id) -> [Membership] fails  !db  @218-226
    -- GET /relays/{id}/memberships: its paid memberships, newest first.

  pub async fn get_payouts(actor, pubkey) -> PayoutStatus fails  !net !db  @231-239
    -- GET /tenants/{pubkey}/payouts: refreshed from Stripe, whether members can pay the tenant.
  pub async fn onboard_payouts(actor, pubkey, return_url?) -> {url} fails  !net !db  @243-255
    -- POST /tenants/{pubkey}/payouts/onboard: a Stripe onboarding link back to return_url, else
    -- the tenant's own return_url; the tenant only.
  pub async fn open_payouts_dashboard(actor, pubkey) -> {url} fails  !net !db  @258-266
    -- POST /tenants/{pubkey}/payouts/dashboard: a Stripe payouts login link; the tenant only.

  pub async fn add_relay_member(actor, id, pubkey) fails  !db !time     @269-279
    -- PUT /relays/{id}/members/{pubkey}: make a 64-hex pubkey a member by hand; the core refuses
    -- a purged relay.
  pub async fn remove_relay_member(actor, id, pubkey) fails  !db !time  @282-291
    -- DELETE /relays/{id}/members/{pubkey}: remove a member; the core refuses the owner and a
    -- purged relay.
  fn validate_pubkey(pubkey) fails  -- invalid-pubkey unless 64 hex characters  @293-302

  pub async fn list_relay_activity(actor, id) -> {activity} fails  !db  -- GET /relays/{id}/activity  @304-313
  pub async fn deactivate_relay(actor, id) fails  !db !time !rand  -- POST /relays/{id}/deactivate  @315-324
  pub async fn reactivate_relay(actor, id) fails  !db !time !rand  -- POST /relays/{id}/reactivate  @326-335
