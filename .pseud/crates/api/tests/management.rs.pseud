module caravel_api::tests::management
  -- Managing a relay from the dashboards: NIP-86 methods, members and roles, rooms, event paging.

  tests                                                                 @13-307
    fn pubkey() -> str                                                  @13-15
      -- A fresh random pubkey in hex.
    test an_owner_calls_the_relays_methods_and_a_stranger_may_not       @18-115
      -- another relay's owner gets 403 on POST /relays/{id}/management
      the owner sees banpubkey among supportedmethods, bans a pubkey and lists it with its reason
      createrole, allowpubkey, assignrole show in GET /members as the role and a manual member
      an unknown method is 400
    test a_purged_relays_members_are_out_of_reach                       @118-134
      -- GET /members and PUT and DELETE /members/{pubkey} on a purged relay are 400 relay-is-purged
    test rooms_are_moderated_through_the_relays_key                     @137-204
      -- create, edit, put-user, grant 9005 and an invite code for a room through rooms/moderate
      GET /rooms shows the name tag, the invite, and the member with role host and permission 9005
      a plain note, a second create, and a remove from an unknown room are each 422
    test a_relays_events_are_paged_by_kind_and_id                       @207-249
      -- GET /events filters by kinds, ids, until and limit; a non-numeric kind is 422
    test a_relays_events_page_past_a_shared_second_and_leave_out_its_own  @252-307
      -- pages of 2 with until and after walk five notes sharing a second, in id order, then end
      exclude_own=true leaves out an event the relay signed; a non-hex after is 422
