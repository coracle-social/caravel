module caravel_core::management  !db !time
  -- Running a relay's members, NIP-86 calls and room moderation from the dashboards.

  pub async fn call(core, relay, call: Call) -> Outcome fails  !db !time  @19-108
    -- Carry out a NIP-86 call; the caller reloads the relay and delivers an AccessChanged outcome.
    match call
      the List calls -> Answer with the bans, members ("relay member"), banned events or claims
      ListMethodAssignees -> the tenant and relay key with every MANAGED_METHODS, then each grantee
        all sorted by pubkey
      ChangeRelayName, ChangeRelayDescription, ChangeRelayIcon -> change_info
      UnbanPubkey, AllowEvent, CreateClaim, DeleteClaim -> one write on the pool
        AccessChanged with nothing published
      every other call -> write in one transaction, AccessChanged with what it published
  pub async fn moderate_room(core, relay, kind: u16, tags) fails  !db !time  @113-148
    -- Publish a NIP-29 moderation event as the relay itself and apply it to its room.
    fail if the relay is purged, or invalid "invalid-kind" unless kind is a moderation kind
    sign the event with the relay's key, now
    check it against the room rules on a policy snapshot; a refusal fails invalid "refused"
    in one transaction: save the event, then commands::rooms::apply_event
    publish AccessChanged with the event first, then what applying it published
  fn change_info(core, relay_id, name?, description?, icon?) -> Outcome fails  !db  @151-163
    -- Set the relay's info on the pool, then RelayChanged so it reloads; answers true.
  fn write(conn, key, relay, call, now) -> [Event] fails  !db !-panic  -- only call reaches it  @166-220
    -- Run a call that changes what the relay publishes, on the caller's transaction.
    match call
      BanPubkey -> commands::bans::ban_pubkey
      AllowPubkey -> commands::members::allow_pubkey, admitting and unbanning
      UnallowPubkey -> commands::members::remove, which refuses the owner and the relay's key
      BanEvent -> commands::bans::ban_event, publishing nothing
      CreateRole, EditRole, DeleteRole, AssignRole, UnassignRole -> the commands::roles of each
      AssignMethod -> grant_method; UnassignMethod -> revoke_method, publishing nothing
      any other call is unreachable, since call routes only these here
  pub async fn add_member(core, relay, pubkey) fails  !db !time         @223-239
    -- Admit pubkey as a Manual member in one transaction, then publish AccessChanged.
    -- Fails on a purged relay.
  pub async fn remove_member(core, relay, pubkey) fails  !db !time      @242-259
    -- Remove a member, never the owner, in one transaction, then publish AccessChanged.
    -- Fails on a purged relay.
