module @/tenant/lib/rooms  !rand
  -- NIP-29 kinds the dashboard publishes, room permissions and flags, and reading a room's tags.

  pub const PUT_USER = 9000                                             @4
  pub const REMOVE_USER = 9001                                          @5
  pub const EDIT_METADATA = 9002                                        @6
  pub const CREATE_GROUP = 9007                                         @7
  pub const DELETE_GROUP = 9008                                         @8
  pub const CREATE_INVITE = 9009                                        @9
  pub const ASSIGN_PERMISSION = 9011                                    @10
  pub const UNASSIGN_PERMISSION = 9012                                  @11
  pub const PERMISSIONS  -- what a room member may be permitted: each a kind they may publish  @14-24
    9000 add members and set roles, 9001 remove members, 9002 edit the room
    9005 delete messages, 9008 delete the room, 9009 create invite codes, 9010 pin messages
    9011 grant and 9012 revoke the permissions they hold
  pub fn permissionLabel(kind) -> str  -- its PERMISSIONS label, else "Kind <n>"  @26-27
  pub const ROOM_FLAGS = [restricted, private, hidden, closed]  -- in Flotilla's order  @30-35
  pub fn roomTag(room, name) -> str  -- the first value of the named tag, "" when missing  @37
  pub fn roomHasFlag(room, name) -> bool  -- whether any tag has that name  @39
  pub fn roomName(room) -> str  -- its name tag, else its id            @41
  pub fn newRoomId() -> str  !rand  -- 12 hex characters from 6 random bytes  @44-45
