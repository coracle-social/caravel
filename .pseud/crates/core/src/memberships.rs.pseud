    -- Stop an Active membership renewing at Stripe, then mark it Canceled; access lasts the period.
    -- NotFound "membership not found" without an Active live membership.

  fn lapse(core, membership, relay) fails  !db !time !rand              @366-424
    -- End a membership whose paid period ran out, and tell its member how to renew.
    in one transaction
      set it Lapsed
      with a pubkey: remove the member only if they got in by Payment
      an unbound invite: revoke its claim
    publish AccessChanged
    with a pubkey, after the commit
      start a session for them, and notify them on the relay until it would expire
        "Your membership of <relay> has ended. Renew at <portal url>?token=<session token>"
      a failure here propagates, but the membership has lapsed, so the notice isn't retried
  fn release(core, membership) fails  !net !db !time                    @429-457
    -- End a membership whose relay stopped selling: no more charges, no refund, the member stays.
    with a Stripe customer: expire its open Checkout sessions, then cancel its subscriptions now  !net
    in one transaction: set it Lapsed, revoking an unbound invite's claim

  pub async fn sweep(core) fails  !net !db !time !rand                  @465-493
    -- Bring every membership in step with Stripe; each one's failure is logged and skipped.
    release each live membership of a relay that is free, paused or purged
    settle_pending each Pending membership, listed after the releases
    renew_or_lapse each Active or Canceled membership whose period has ended
  fn settle_pending(core, membership) fails  !net !db !time             @497-531
    -- Activate a membership whose checkout completed unseen, or lapse it after PENDING_TTL.
    with a Stripe customer
      past PENDING_TTL, note whether it has an open Checkout session  !net
        listed before the subscriptions, so a session completed in between shows as paid
      activate through its first live subscription; done if that takes  !net
      done if a session was open: a checkout reopened on the old membership can still be paid
    past PENDING_TTL, set it Lapsed
  fn renew_or_lapse(core, membership) fails  !net !db !time !rand       @537-579
    -- Settle a paid membership whose period ended, from Stripe.
    read the subscription with its latest invoice  !net
    its period moved on, in good standing, latest invoice paid -> store that end and its status
    still collecting, until RENEWAL_GRACE past the stored period end -> leave it for the next sweep
      collecting: not Stopped, and either moved on or not set to cancel
      covers not cycled yet, the renewal invoice's draft hour, and Stripe's retries
    if Stripe still lists it as live, cancel it now, so nothing charges a membership moving on  !net
    if the customer has another live subscription and activate takes it, it carries on  !net
    otherwise lapse it
  fn status_of(subscription) -> MembershipStatus  -- Canceled if it won't renew, else Active  @583-589
