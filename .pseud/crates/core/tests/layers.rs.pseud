% source=crates/core/tests/layers.rs lang=rust lines=230 sha=e8b2414472a3

module caravel_core::tests::layers
  -- Enforces the core's internal layering by reading the text of crates/core/src.

  tests  !panic !fs                                                     @14-230
    const FOUNDATIONS = [blank, config, crypto, error, flag]  -- modules every layer may use  @14
    const RUNTIME = [bus, clock, Core]  -- foundations only subsystems may use  @17
    const LAYERS  -- what each layer may use besides itself and the foundations  @20-25
      models: nothing; domain: models; queries: models, domain; commands: models, domain, queries
    data Source { path, module, text }  -- module: the file's layer directory, or its stem  @27-32
    fn sources() -> [Source]  !panic !fs                                @34-61
      -- Every file under crates/core/src one directory deep, except lib.rs and testing.rs.
    fn is_layer(module) -> bool  -- named in LAYERS                     @63-65
    fn is_foundation(module) -> bool  -- in FOUNDATIONS or RUNTIME, or Error or Result  @67-72
    fn uses(text) -> Set<str>                                           @75-79
      -- The top-level modules a file names through `crate::`, grouped imports included.
      -- Textual, comments included; `super::` paths and other crates are never seen.
    fn first_segments(tree) -> [str]  !panic                            @83-112
      -- First segment of each path in a use tree: `{a::{b, c}, d}` names a and d.
      split a brace group on the commas outside its nested groups, stopping at its close
      take each item's first segment
    test layers_use_only_the_layers_before_them                         @115-134
      -- A layer's files name via `crate::` only that layer, its LAYERS entry, FOUNDATIONS, Error
      -- and Result; so no layer reaches bus, clock, Core or a subsystem.
    test foundations_use_only_foundations                               @137-148
      -- Foundation files, RUNTIME's included, name only FOUNDATIONS, Error and Result.
    test only_queries_and_commands_touch_the_database                   @151-167
      -- Outside queries and commands every match is judged: no sqlx::query or QueryBuilder,
      -- and `.with_tx(` only in subsystems and foundations.
      exact                                                             @152
        let sql = Regex::new(r"sqlx::query|QueryBuilder|\.with_tx\(").unwrap();
    test queries_only_read_and_rules_are_pure                           @170-190
      -- Textual: queries have no uppercase "INSERT INTO", "DELETE FROM" or "UPDATE <word> SET";
      -- commands never call `.with_tx(`; models and domain have no "async fn" or PgExecutor.
    test subsystems_depend_on_each_other_without_cycles                 @193-230
      -- Subsystems (neither a layer nor a foundation) use each other without a cycle.
      graph each subsystem to the other subsystems any of its files uses
      repeatedly drop subsystems whose dependencies are all dropped; fail naming what remains
