module caravel_core::notifications  !db !time
  -- Notifications: one message per pubkey per relay, sent as NOTIFY until replaced or expired.

  pub async fn notify(core, relay_id, pubkey, message, expires_at: i64?) fails  !db !time  @12-42
    -- Replace a pubkey's message on a relay, and deliver it now unless it has expired.
    fail invalid "message-required" if the message is empty
    set the notification, stamped now
    publish Notified on the bus unless expires_at has already passed
