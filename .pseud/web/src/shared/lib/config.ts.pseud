% source=web/src/shared/lib/config.ts lang=typescript lines=35 sha=2be41af8f4f8

module @/shared/lib/config  !env
  -- The runtime configuration the server writes into each app's page, else VITE_* under `vite dev`.

  data Injected { api_url, relay_domains, platform_name, platform_logo, flotilla_url, relay }  @3-11
  fn readInjected() -> Injected  -- the JSON in the page's #config element; {} if missing or bad  @13-19
  global injected = readInjected()                                      @21
  pub const API_URL  !env  -- injected api_url, else VITE_API_URL       @23
  pub const RELAY_DOMAIN  !env  -- where new relays go: the first injected relay domain, else the env's  @25-26
  pub const PLATFORM_NAME  !env  -- injected, else VITE_PLATFORM_NAME, else "Caravel"  @28
  pub const PLATFORM_LOGO  !env  -- injected, else VITE_PLATFORM_LOGO, else "/caravel.png"  @30
  pub const FLOTILLA_URL  !env  -- injected, else VITE_FLOTILLA_URL, else "https://app.flotilla.social"  @32
  pub const PORTAL_RELAY  -- the RelayProfile a member portal is served for  @34-35
