module @/shared/components/relay/MemberPriceModal  !net !db !time
  -- The dialog for setting what a relay charges its members.

  type Props = { open, onClose, relay(), onSaved(relay) }               @9-14
  const MIN_PRICE = 50  -- Stripe's minimum charge, in cents            @17
  pub fn MemberPriceModal(props: Props)  !net !db !time                 @19-181
    -- Setting a relay's recurring member price and interval, or making it free.
    while open, fetch the owner's payout status, showing its platform fee  @20
    each opening resets the price and interval to the relay's           @33-40
    until payouts are ready, the form is replaced                       @84-108
      the owner -> a button to start or finish Stripe payout onboarding, returning here
      anyone else -> a note that the owner hasn't finished; a failed check shows an error
    Save needs a price of at least MIN_PRICE cents, and is disabled while public join is on  @150
    saving sends member_price and member_interval, hands the relay to onSaved and closes  @42-53
      a failure shows in the dialog
    a paid relay can be made free by saving price 0, which ends every member's subscription  @164-178
