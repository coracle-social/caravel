module caravel_core::domain::relays
  -- The rules for a relay's settings and the hosts it answers on.

  pub fn url_host(url) -> str                                           @14-29
    -- The host a url or Host header names, lowercased, minus scheme, path, numeric port, final dot.
  const RESERVED_SUBDOMAINS = [api, admin, internal]                    @31
  const MIN_MEMBER_PRICE = 50  -- cents, the least Stripe charges       @33-34
  global SUBDOMAIN_RE  !-panic !-global  -- 3 to 63 of a-z, 0-9 and inner hyphens; compiled once  @36-37
  pub fn apply_settings(config, relay, settings) -> Relay fails         @39-109
    -- Overlay each chosen setting on the relay; unset ones keep their values.
    a new subdomain, or a new domain trimmed and lowercased, withdraws verification
    a custom domain goes through normalize_custom_domain; if it differs, verification is withdrawn
    the subdomain, plan, info, flags and member price are taken as given, for validate_relay
  pub fn validate_relay(config, relay) -> Relay fails                   @111-153
    -- The relay as a whole, failing invalid with the first problem found.
    "invalid-subdomain" unless it matches SUBDOMAIN_RE, isn't reserved, and its canonical host
      isn't is_platform_host
    "invalid-zooid-domain" unless the domain is one of config.relay_domains
    "invalid-plan" for an unknown plan; "premium-feature" for blossom or livekit off its plan
    "invalid-member-price" for a price other than 0 below MIN_MEMBER_PRICE, negatives included
    "paid-public-join" for a member price on a relay anyone may join
