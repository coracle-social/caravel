module caravel_relay::message
  -- NIP-01 wire messages: ClientMessage parsed from what arrives, RelayMessage written back.

  pub const MAX_SUBSCRIPTION_ID_LEN = 64                                @15-16
  pub data SubscriptionId(str)  -- 1 to 64 characters, as NIP-01 requires  @18-21
  impl SubscriptionId                                                   @23-34
    pub fn new(id) -> SubscriptionId fails InvalidSubscriptionId  -- empty or over 64 chars fails  @24-33
  impl Serialize for SubscriptionId  -- as its string                   @36-40
  impl Deserialize for SubscriptionId  -- a string, validated by new    @42-48
  pub data InvalidSubscriptionId(str)                                   @50-52
  impl Display for InvalidSubscriptionId  -- "subscription id must be 1-64 characters, got N"  @54-62
  impl Error for InvalidSubscriptionId                                  @64

  pub fn refused_event(event_id, refusal) -> RelayMessage  -- OK, refusal.accepted(), its message  @66-73
  pub fn refused_subscription(subscription_id, refusal) -> RelayMessage  -- CLOSED with its message  @75-81
  pub fn refused_reconciliation(subscription_id, refusal) -> RelayMessage  -- NEG-ERR, its message  @83-89

  pub data RawEvent(RawValue)  -- an event's json as the store rendered it, sent on unparsed  @91-93
  impl RawEvent                                                         @95-100
    pub fn from_json(json) -> RawEvent fails serde_json::Error          @96-99
  ~ RawEvent compares by its json text and serializes as that raw json  @102-114

  pub enum ClientMessage                                                @116-153
    -- What a client sends.
    Event(Event)  -- ["EVENT", event]
    Req { subscription_id, filters: [Filter] }  -- ["REQ", id, filter…]; the filters are a union
    Close(SubscriptionId)
    Count { subscription_id, filters: [Filter] }  -- NIP-45
    Auth(Event)  -- a NIP-42 answer
    NegOpen { subscription_id, filter, message }  -- NIP-77, the negentropy message still hex
    NegMsg { subscription_id, message }
    NegClose(SubscriptionId)
  impl Deserialize for ClientMessage  -- as a sequence, through ClientMessageVisitor  @155-159
  data ClientMessageVisitor                                             @161
  impl Visitor for ClientMessageVisitor                                 @163-225
    fn expecting(self, f)  -- "a nostr client message array"            @166-168
    fn visit_seq(self, seq) -> ClientMessage fails                      @170-224
      -- Read the verb, then the elements that verb takes.
      EVENT, AUTH, CLOSE and NEG-CLOSE take one element
      NEG-OPEN takes id, filter and message; NEG-MSG id and message
      REQ and COUNT take an id, then every remaining element as a filter, failing with none
      an unknown verb fails
      elements past the ones a verb takes are ignored, for later NIPs

  pub enum RelayMessage                                                 @227-275
    -- What the relay sends back.
    Event { subscription_id, event: RawEvent }
    Ok { event_id, accepted: bool, message }  -- a refusal leads with a machine-readable prefix
    Eose(SubscriptionId)
    Count { subscription_id, count: u64 }
    Closed { subscription_id, message }
    Notice(str)
    Auth { challenge }
    NegMsg { subscription_id, message }
    Notify(str)  -- for the account the connection is authenticated as
    NegErr { subscription_id, reason }
  impl RelayMessage                                                     @277-302
    pub fn accepted(event_id) -> RelayMessage  -- OK true with an empty message  @278-285
    pub fn verb(self) -> str  -- its wire name, for logs                @287-301
  impl Serialize for RelayMessage                                       @304-395
    -- Each as a JSON array led by its verb, fields in NIP order; COUNT's count as {"count": n}.

  fn required(seq, index) -> T fails  -- the next element, or an invalid-length error  @397-406
  fn drain(seq) fails  -- consume what is left, ignoring it             @408-414

  tests                                                                 @416-595
    ~ reads EVENT (still verifying, tags intact), REQ with several filters, COUNT and CLOSE
    ~ refuses REQ without filters, unknown verbs, non-arrays and ids of the wrong length
    ~ ignores trailing elements; writes OK, EOSE, COUNT and NOTICE as NIP-01 arrays
