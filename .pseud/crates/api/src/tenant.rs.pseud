    -- POST /invoices/{id}/reconcile: collect an open invoice now, without the reminder DM a
    -- failure would send, and return it re-read.
  pub async fn ensure_invoice_bolt11(actor, id) -> Bolt11 fails  !net !db !time !rand  @433-441
    -- POST /invoices/{id}/bolt11: a payable Lightning invoice for it.
  pub data CheckoutParams { return_url }  -- where Stripe sends the tenant afterwards  @444-447
  pub async fn ensure_invoice_checkout(actor, id, params) -> {url} fails  !net !db !time !rand  @451-463
    -- POST /invoices/{id}/checkout?return_url=: a Stripe Checkout page for paying by card, which
