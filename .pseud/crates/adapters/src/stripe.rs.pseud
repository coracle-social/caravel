module caravel_adapters::stripe  !panic !net !time
  -- The subset of the Stripe REST API caravel uses, returning plain values.

  const STRIPE_API = "https://api.stripe.com/v1"                        @9
  const STRIPE_VERSION = "2026-09-30.endive"  -- pinned on every request  @12
  const CURRENCY = "usd"                                                @15
  const TIMEOUT = 30s  -- so a hung request can't stall billing         @18
  pub data Stripe { http, secret_key, api }                             @20-25

