module @/shared/lib/api  !net !db !time
  -- The dashboards' wire types, the session tokens they keep per pubkey, and a function per route.
  -- Every route function but listPlans sends the signed-in account's session through callApi.

  pub data Plan  -- members is null for unlimited                       @6-17
    id, name, amount, members?, blossom, livekit, storage_gb, storage_overage, av_hours, av_overage
  pub type PlanId = str                                                 @19
  pub type Flag = 0 | 1  -- a relay setting the API reads and writes as 0 or 1  @21-22
  pub enum RelayFlag                                                    @24-36
    policy_public_read | policy_anonymous_read | policy_public_write | policy_public_join
    policy_strip_signatures | groups_enabled | management_enabled | members_can_invite
    blossom_enabled | blossom_authenticated_read | livekit_enabled | push_enabled
  pub type RelayStatus = active | inactive | delinquent                 @38
  pub type MemberInterval = month | year                                @40
  pub data Relay  -- every RelayFlag as a Flag, and these               @42-62
