module @/tenant/pages/relays/RelayReports  !net !db !time
  -- A relay's reports tab: NIP-56 reports members sent it, and acting on each.

  const REPORT = 1984                                                   @14
  fn tagValue(event, name, index = 1) -> str?  -- the first such tag's value at index  @16
  fn reportReason(report) -> str  -- the report type on its e tag, else its p tag, else ""  @19
  pub fn RelayReports()  !net !db !time                                 @22-148
    -- Each report's reporter, reason, the reported event or user, and Dismiss, Delete and Ban.
    page reports 20 at a time with usePagedEvents                       @24
    fetch the reported events by every e-tagged id across loaded reports  @27-31
      100 ids per request, the most events a page returns, all at once
      refetching all of them each time a page arrives
    fn dismiss(report)  !net !db !time                                  @34-37
      NIP-86 banevent [report id, "Dismissed"], so it also lists under Banned events
      then drop it from the feed
    fn deleteTarget(report, id)  !net !db !time                         @40-46
      NIP-86 banevent [id, reason], then dismiss every shown report that e-tags it, toasting once
        dismissals run at once; each one that succeeds leaves the feed
    fn banAuthor(report, pubkey)  !net !db !time                        @49-56
      NIP-86 banpubkey [pubkey, reason], which deletes every report pubkey made
      then dismiss this report and every other shown one p-tagging pubkey, toasting once
      on success drop pubkey's own reports from the feed
