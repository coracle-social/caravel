module @/tenant/components/relay/PubkeyDialog
  -- A dialog asking for a pubkey, for adding members and banning users.

  data PubkeyDialogProps                                                @7-16
    open, title, description?, submitLabel
    noteLabel?: str  -- shows a second, optional field, such as a ban's reason
    onClose()
    onSubmit(pubkey, note) -> Promise  -- its failure keeps the dialog open with the error
  pub fn PubkeyDialog(props: PubkeyDialogProps)                         @19-96
    -- Asks for a pubkey as npub, nprofile or hex and hands it to onSubmit.
    clear the input, note and error each time it opens
    fn submit(e)                                                        @32-50
      normalize the trimmed input with applesauce; fail inline "Enter an npub or a hex pubkey."
        normalizeToPubkey also takes an naddr's author and derives an nsec's pubkey
      await onSubmit with the pubkey and trimmed note, then close
      on failure show formatError in the dialog and stay open
    closing is refused while it submits
