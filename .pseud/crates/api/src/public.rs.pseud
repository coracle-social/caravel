    -- GET /domains/check?domain=: on-demand TLS's ask, answered as a bare status.
    400 without domain; 200 if domains::is_served_host, else 404
    a failed lookup is logged and answers 404, so no certificate is issued meanwhile
  data SessionResponse { pubkey, token, expires_at }                    @44-48
  pub async fn create_session(headers) -> SessionResponse fails  !db !time !rand  @51-62
    -- POST /session: a NIP-98 header signed for exactly POST <api_url>/session buys a token; 201.
  pub async fn delete_session(headers) fails  !db                       @65-71
    -- DELETE /session: end the session whose Bearer token is sent; Unauthorized without one.
  pub async fn get_identity(actor) -> Actor fails  -- GET /identity: pubkey and is_admin  @73-75
