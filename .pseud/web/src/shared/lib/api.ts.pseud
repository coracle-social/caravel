    custom_domain, custom_domain_verified, redirect_from, info_name, info_icon, info_description
    member_price  -- cents per member_interval, or 0 if joining is free
    member_interval, purged_at?, erased_at?
  pub type RelaySettings  -- what a tenant may set: a partial pick of Relay's settable fields  @64-79
  pub type NewRelay = RelaySettings requiring tenant_pubkey, subdomain, zooid_domain, plan_id  @81
  pub data RelayProfile { relay_id, host, name, icon, description }  -- what a relay's portal shows  @83-90
  pub fn relayStatus(relay) -> RelayStatus | "deleted"                  @92-96
    -- "deleted" once purged_at is set, since a deleted relay keeps the status it had.
  pub fn relayName(relay) -> str  -- info_name, else subdomain          @98-100
  pub fn canonicalHost(relay) -> str  -- "<subdomain>.<zooid_domain>", the host every relay has  @102-105
  pub fn relayPortalUrl(relay) -> url                                   @107-111
    -- The portal members pay on: https://<custom domain>/ once verified, else the canonical host.
  pub type MembershipStatus = pending | active | canceled | lapsed      @113
  pub data Membership  -- a paid membership; its invite has no pubkey until someone joins with it  @115-125
    id, relay_id, pubkey?, invite_code?, status, current_period_end?, bound_at?, created_at
  pub data PayoutStatus { account_id?, ready, fee_percent }  -- can members pay, and the cut  @127-132
  pub data Tenant                                                       @134-146
    pubkey, return_url, nwc_is_set, created_at, billing_anchor?, stripe_customer_id
