module caravel_core::testing  !panic !db !global !time !rand
  -- A test core: this binary's database, a pinned clock, and adapters aimed at closed ports.

  pub const RELAY_DOMAIN = "relay.test"  -- the relay domain test relays are created under  @16-17
  pub const API_URL = "http://api.test"  -- the API base url test requests sign for  @19-20
  pub const PLATFORM_URL = "http://app.relay.test"  -- the dashboards', under the relay domain  @22-23
  const DEAD_RELAY = "ws://127.0.0.1:1"                                 @25
  pub const LIVEKIT_URL = "ws://127.0.0.1:1"  -- a LiveKit server that isn't there  @27-28
  const PLATFORM_SECRET  -- one platform key for every test core, so relays decrypt across tests  @30-32

  pub async fn core(admin_pubkey) -> Core  !panic !db !global !time !rand  @34-76
    -- A core on this test binary's database, administered by admin_pubkey.
    config: API_URL, PLATFORM_URL, RELAY_DOMAIN, a 10% member fee, a test Flotilla url
      and PLATFORM_SECRET as its key
    the robot shares PLATFORM_SECRET and publishes only to DEAD_RELAY
    a fresh NWC wallet on DEAD_RELAY, in-memory blobs, LiveKit at LIVEKIT_URL, a fake Stripe key
    outbound allows private addresses, so tests can serve push callbacks locally
  pub fn sign_event(secret, kind: u16, content, tags, created_at) -> Event  -- a signed event  @78-99
  pub fn authorization(event) -> str  !panic  -- "Nostr <base64 JSON>", as NIP-98 and Blossom take  @101-109
  pub fn http_auth(secret, url, method, created_at) -> str  !panic  -- a NIP-98 header for url and method  @111-126
  pub async fn insert_tenant(core, pubkey)  !panic !db !time            @128-142
    -- Make a pubkey a tenant with a fake customer id, without reaching Stripe.
  pub fn subdomain() -> str  !rand  -- "r" and 12 random hex characters, unique per test  @144-147
  pub async fn create_relay(core) -> (Relay, SecretKey)  !panic !db !time !rand  @149-172
    -- A new tenant and their relay on the free plan under RELAY_DOMAIN, with the tenant's key.
