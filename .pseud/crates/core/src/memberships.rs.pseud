module caravel_core::memberships  !net !db !time !rand
  -- Paid memberships of relays through Stripe Connect, each driving the relay's access list.

  const PENDING_TTL = 2 days  -- Stripe expires Checkout sessions after a day  @20
  const RENEWAL_GRACE = 14 days  -- access past a period's end while Stripe collects its renewal  @24

