      -- The id of the customer's first saved card, the one charged.
    pub async fn create_payment_intent(self, customer_id, payment_method_id, attempt_id, invoice_id, amount) -> Charge fails  !net  @123-169
      -- Charge amount cents to a saved card off-session and confirm it, idempotent on attempt_id.
      -- Fails when it can't be known whether the card was charged.
      a 4xx is Refused, but a 409 (a request still in flight) or a 429 fails
      a 5xx or no answer fails
      succeeded -> Succeeded(id); processing fails; anything else, such as requires_action, Refused
