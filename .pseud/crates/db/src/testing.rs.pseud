module caravel_db::testing  !panic !db !env !global
  -- One database per test binary, created fresh from TEST_DATABASE_URL on first use.

  const DEFAULT_URL = "postgres://caravel:caravel@127.0.0.1:55433/postgres"  -- just pg's  @10
  global URL: OnceCell<str>  !global  -- this binary's database url, created once  @12
  pub async fn connect() -> Db  !panic !db !global                      @15-21
    -- A pool of 4 on this binary's database, creating and migrating it on the first call.
  async fn create_database() -> str  !panic !db !env                    @23-59
    -- Recreate this binary's database and migrate it, returning its url.
    connect to TEST_DATABASE_URL, else DEFAULT_URL, panicking with a hint to run `just pg`
    DROP DATABASE IF EXISTS the binary's name WITH (FORCE), then CREATE it
    build its url by swapping the database name, keeping any query string
    migrate it over a single connection, then close that pool
  fn database_name() -> str  !panic                                     @63-81
    -- caravel_test_<binary>_<hash>, from the executable's name, lowercased.
    -- Cargo's hash differs per crate, so same-named binaries in two crates don't share one.
    -- Characters other than ASCII letters and digits become "_".
