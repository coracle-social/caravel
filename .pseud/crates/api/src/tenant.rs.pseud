    -- GET /relays/{id}/export: an unpurged relay's events streamed as an application/x-ndjson
    -- attachment named <subdomain>.jsonl, outside the envelope.
  pub async fn import_relay_data(actor, id, body) -> ImportResult fails  !db !time  @388-407
    -- POST /relays/{id}/import: stream a JSONL body into an unpurged relay, reporting refused lines.
    413 import-too-large if the body claims more than MAX_IMPORT_SIZE
    otherwise read it through a limit, so a body that passes it breaks off there

