  pub async fn admit_join(conn, key, relay: Relay, event, join: Join, now) -> [Event] fails  !db  @68-109
    -- Admit a NIP-43 join, returning what the relay published.
    lock the relay's row, so racing joins see each other's seats
    match join
      AlreadyMember -> admit nobody
      Open -> admit as PublicJoin
      Claim(code) -> fail conflict "invalid-claim" unless the claim is live
        bind_invite: Payment if it bound a paid invite, else Claim
    if admitting, fail conflict "member-limit" unless has_seat, then commands::members::admit
