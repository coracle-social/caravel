module @/shared/components/relay/PlanGatedToggle
  -- The switch for a feature only paid plans include.

  type PlanGatedToggleProps                                             @5-12
    -- enabled, planLimited, showPlanActions, canUpdatePlan, editHref?, onToggle?
  pub fn PlanGatedToggle(props: PlanGatedToggleProps)                   @15-45
    -- A feature's switch, or on a plan without the feature, a prompt to upgrade.
    if not planLimited, or plan actions are hidden -> the switch
    else if canUpdatePlan -> a static "Update Plan" label, the plan picker being on the page
    else -> an "Upgrade Plan" link to editHref
