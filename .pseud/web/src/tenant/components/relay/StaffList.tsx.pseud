module @/tenant/components/relay/StaffList  !net !db !time
  -- Who may call which of a relay's NIP-86 methods, besides its owner and itself.

  pub fn StaffList(props: { relay })  !net !db !time                    @15-79
    -- Each assignee with their method count; Add staff, and per assignee Edit methods and Remove.
    read the assignees with NIP-86 listmethodassignees and the choices with supportedmethods
    the owner and the relay's own key hold every method and get no actions  @21
    fn remove(assignee)  !net !db !time                                 @23-30
      NIP-86 unassignmethod for each method it holds, one at a time, with no confirmation
      a failure stops the rest and toasts; refetch the assignees either way
  fn StaffDialog(props: { relayId, assignee?, methods, onClose, onSaved })  !net !db !time  @82-177
    -- Method checkboxes for an assignee or "new", with a pubkey field for new staff.
    fn save()  !net !db !time                                           @105-130
      the pubkey is the assignee's, or the normalized input; fail inline when it isn't one
      NIP-86 assignmethod for each newly checked, then unassignmethod for each unchecked, in turn
        assignmethod also admits the pubkey as a member                 @crates/core/src/commands/methods.rs:36-38
        new staff start from no methods, so a pubkey that already holds some only gains
      on success onSaved and close; on failure show the error, onSaved, and stay open
