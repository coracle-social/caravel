% source=crates/core/src/models/members.rs lang=rust lines=32 sha=568555851c1c

module caravel_core::models::members
  -- Relay members: who belongs to a relay, how they joined, and the roles they hold.

  pub enum MemberSource  -- how a pubkey became a member, stored snake_case  @6-23
    Owner  -- the relay's tenant, who is always a member
    Manual  -- added by the tenant, an admin, or a pubkey granted the method
    Claim  -- joined with an invite claim
    PublicJoin  -- joined a relay that takes anyone
    Payment  -- paid for a membership
    Migrated  -- carried over from zooid
  pub data RelayMember                                                  @25-32
    pubkey: str
    source: MemberSource
    roles: [str]  -- role ids held, in the order assigned
    created_at: i64
