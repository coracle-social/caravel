module caravel_core::tests::rooms
  -- NIP-29 rooms (ported from zooid): room ids, moderation events, who may post, rebuilding state.

  tests  !panic !db !time                                               @21-826
    data Fixture { core, relay, key: RelayKey, owner }                  @21-26
    async fn fixture() -> Fixture  !panic  -- a fresh core and relay, with its key and owner  @28-38
    impl Fixture  !panic !db !time                                      @40-114
      fn now(self) -> i64  !time  -- the core's clock                   @41-43
      async fn snapshot(self) -> RelaySnapshot  !panic !db  -- queries::policy::load_snapshot  @45-49
      async fn publish(self, author, kind, tags) -> [Event] fails Refusal  !panic !db !time  @53-75
        -- Ingest as the relay does: check_room_write on a fresh snapshot, then in one transaction
        -- save the event (asserting it is New) and apply it to its room, returning what it published.
      async fn store(self, event) -> Saved  !panic !db !time  -- save without room checks or effects  @77-86
      async fn exists(self, event) -> bool  !panic !db                  @88-93
      async fn published(self, kind, room) -> Event?  !panic !db !time  @96-113
        -- The relay's latest event of kind with d = room.
    fn values(event, name) -> [str]  -- every value of the event's tags named name  @116-118
    test an_event_names_its_room_by_d_for_room_state_and_h_otherwise    @121-134
    test creating_a_room_publishes_its_metadata_and_admins              @137-165
      -- 39000 with name and flags but no h, and 39001 naming the creator; creating again is refused.
    test only_moderators_change_a_room_and_nobody_writes_its_state_directly  @168-204
      -- PUT_PINS publishes pins of e and a tags; members can't pin; PINS itself is refused;
      -- an unknown room is "group not found".
    test editing_a_room_replaces_its_metadata  -- flags the edit leaves out are dropped  @207-257
    test moderators_put_and_remove_members  -- each republishes the member list  @260-298
    test a_closed_room_admits_only_joins_with_its_invite                @301-346
      -- A join without the code, or with a wrong one, is stored but admits nobody; the code admits
      -- everyone who presents it.
    test a_room_is_moderated_by_the_kinds_its_members_are_permitted     @349-510
      -- Neither relay methods nor a room "admin" role grant room moderation; only permitted
      -- kinds do. A moderator may grant only kinds they hold, and only moderation kinds exist.
      -- The admin list gives each admin's kinds (the owner all of them), the member list roles.
      -- Revoking a kind keeps the holder in the room.
    test joining_and_leaving_a_room_is_published_by_the_relay           @513-551
      -- The relay signs the PUT_USER and REMOVE_USER; repeats are Unchanged.
    test a_closed_room_takes_joins_only_with_an_invite_and_a_hidden_one_hides  @554-593
      -- A closed, hidden room is "group not found" to outsiders until they join with the code.
    test deleting_events_stays_within_the_room_and_spares_its_state     @596-634
      -- What it deleted is refused if stored again; the other room's event is a Duplicate.
    test deleting_a_room_removes_it_and_everything_in_it                @637-686
      -- State, pins, members and posts go, leaving only the deletion; it can be created afresh.
    test rooms_that_are_off_take_no_room_events  -- "groups are not enabled"  @689-705
    test rebuilding_the_published_state_reproduces_it                   @710-797
      -- After roles, grants, joins, permissions and pins, rebuild_derived emits exactly the relay's
      -- current member list, roles and room state, and the stored state afterwards still matches.
    async fn published_state(f) -> Map<(kind, d), tags>  !panic !db     @799-818
      -- The relay's own member list, role and room state events, keyed by kind and d.
    fn tags(event) -> [[str]]  -- the event's tags as string lists      @820-826
