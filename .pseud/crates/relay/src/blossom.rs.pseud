module caravel_relay::blossom  !net !db !fs !lock !time
  -- Blossom media on a relay's hosts: members upload, mirror, list and delete; downloads hardened.

  const MAX_DRIFT = 600  -- seconds an authorization may be dated ahead of now  @21-22
  const INLINE_TYPES  -- the types a browser shows without running them; all else downloads  @24-46
    image/apng, avif, gif, heic, heif, jpeg, png, webp
    audio/aac, mp4, mpeg, ogg, wav, webm
    video/mp4, mpeg, ogg, quicktime, webm
  pub data Refused(StatusCode, reason)  -- a refusal; its reason also goes in X-Reason  @48-50
  impl Refused                                                          @52-62
    fn new(status, reason) -> Refused                                   @53-55
    fn failed(reason, error) -> Refused  -- a 500 with the reason, logging the cause  @57-61
  impl IntoResponse for Refused  -- the reason as body, and as X-Reason when a valid header  @64-73
  type Answer = Response fails Refused                                  @75

  pub fn parse_name(name) -> sha256?  -- the lowercased 64-hex hash before any extension  @77-81
  fn extension(content_type) -> str?  -- a file extension for 14 common types  @83-101
  fn descriptor(route, blob) -> Value  -- BUD-02's, its url on the primary host with an extension  @103-117
  fn require_media(route) -> () fails Refused  -- 404 unless blossom_enabled  @119-129
  fn authorize(route, headers, verb) -> (pubkey, hashes) fails Refused  !time  @131-184
    -- Check a kind 24242 authorization for verb, returning its signer and the hashes it covers.
    401 unless a "Nostr" Authorization decodes to a validly signed event
    401 unless kind 24242, dated at most MAX_DRIFT ahead, expiring in the future, with t = verb
    401 if it has server tags and none names one of the relay's hosts (BUD-11)
    403 unless the signer has access in the snapshot
    the hashes are its x tags that parse as names
  pub async fn download(route, name, request) -> Answer  !net !db !fs !time  @186-260
    -- BUD-01: a blob's bytes, whole or one range, as a download unless the type shows harmlessly.
    404 unless media is on and the name is a hash
    when the relay keeps media to members, require a "get" authorization, for any blob
    read the blob row, then the bytes of the asked range from the store; 404 if either is missing
    206 with Content-Range for a range, else 200; HEAD sends no body
    the uploader's content type, length, Accept-Ranges and a year's immutable caching, then harden
  fn parse_range(header, size) -> Range?                                @262-279
    -- One "bytes=" span within the blob: start-end clipped to size, start-, or -suffix.
    -- none for several spans, an empty blob or an empty span, which serves the whole blob
  fn harden(headers, content_type)                                      @281-304
    -- nosniff, CSP "default-src 'none'; sandbox", and attachment unless the type is in INLINE_TYPES.
  pub async fn check_upload(route, headers) -> Answer  !time            @306-323
    -- BUD-06: 200 if an upload authorization holds and X-Content-Length fits; else 413 or 411.
  pub async fn upload(route, request) -> Answer  !net !db !fs !lock !time  @325-361
    -- BUD-02: buffer the body and keep it for the signer.
    require media and an "upload" authorization
    413 once Content-Length or the bytes read pass MAX_BLOB_SIZE
    keep it with the request's content type, answering its descriptor
  pub async fn mirror(route, headers, body) -> Answer  !net !db !fs !lock !time  @363-398
    -- BUD-04: fetch {"url"} through the outbound client and keep it for the signer.
    400 unless the authorization names a hash and the body has a url
    fetch up to MAX_BLOB_SIZE, never from a local address; 502 with the cause on failure  !net
    keep it with the fetched content type, else application/octet-stream
  async fn keep(route, pubkey, bytes, content_type, covered) -> Blob fails Refused  !net !db !fs !lock !time  @400-428
    -- Store bytes for an owner, if they hash to a covered name or none are named.
    403 if the authorization names hashes and this isn't one
    media::keep_upload stores and records them; a failure is a 500
  pub async fn list(route, pubkey, headers) -> Answer  !db !time        @430-452
    -- BUD-02: for a member, the descriptors of any hex pubkey's uploads.
  pub async fn delete(route, name, headers) -> Answer  !net !db !fs !lock !time  @454-480
    -- BUD-02: give up the signer's ownership; the last owner's deletion removes the bytes.
    404 unless the name is a hash; 403 unless the "delete" authorization names it
    media::delete_upload, which removes the last owner's bytes too: NotOwned -> 404, else 200
  fn too_large() -> Refused  -- 413 naming MAX_BLOB_SIZE                @482-487
  fn content_type(headers) -> str  -- Content-Type, else application/octet-stream  @489-495

  tests                                                                 @497-518
    ~ ranges cover one span within the blob; names are hashes with an optional extension
