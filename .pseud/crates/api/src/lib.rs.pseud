    -- By the module handling it:
    -- public: GET /plans, GET /plans/{id}, GET /identity, GET /domains/check, POST, DELETE /session
    -- admin: GET /tenants, GET /relays, GET /invoices, DELETE /sessions/{pubkey}, GET /moderation
