module caravel_app::web
  -- The tenant dashboard, the admin dashboard and the member portal: single-page apps built from
  -- web/ and embedded in the binary, each served as an HTML shell carrying its runtime config.

  data Dist  -- web/dist embedded at compile time; a missing build is allowed  @19-22
  pub enum App = Tenant | Admin | Portal                                @26-30
  impl App                                                              @32-41
    fn file_name(self) -> str  -- tenant.html, admin.html or portal.html  @34-40
  enum Files = Embedded | Given(shared Map<path, bytes>)                @44-47
  pub data PageConfig  -- what every app's page is configured with      @51-57
    api_url, platform_name, platform_logo, flotilla_url: str
    relay_domains: [str]
  impl PageConfig                                                       @59-69
    pub fn new(config, web) -> PageConfig                               @60-68
  data Page { ..config: PageConfig, relay: RelayProfile? }  -- the portal's adds its relay  @74-79

  pub data Web { files: Files, config: PageConfig }  -- the built apps and every page's config  @83-86
  impl Web                                                              @88-177
    pub fn new(config) -> Web  -- serving the embedded build            @89-94
    pub fn with_files(config, files) -> Web  -- serving files keyed by path instead  @97-102
    fn read(self, path) -> (bytes, content_type)?                       @104-114
      -- A built file and its type: the embedded file's own, or one guessed from the path.
    pub fn file(self, path) -> Response?                                @118-140
      -- A built file at a request path, never the root or an .html shell; files under assets/
      -- are cached for a year as immutable, the rest for an hour.
    pub fn shell(self, app, relay?) -> Response  !-panic  -- the config holds only strings  @144-176
      -- The app's HTML with its page configuration; 503 when the apps aren't built.
      serialize the config with every < escaped, so no value can end the script element
      insert it as script id=config of type application/json before the first </head>
      serve it as no-cache

  pub fn is_page_request(request) -> bool                               @181-194
    -- A browser navigating: GET or HEAD accepting text/html, without Upgrade, outside
    -- /.well-known/ and not a blob path.
  fn is_blob_path(path) -> bool  -- one segment Blossom parses as a sha256, with any extension  @197-200
