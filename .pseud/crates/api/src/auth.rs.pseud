module caravel_api::auth  !db !time
  -- Extractors that authenticate a request: a handler taking one requires it; without one, public.

  pub data Authed(Actor)  -- the actor behind a session's bearer token  @14
  pub data Admin  -- proof that the request is from a platform admin    @17

  impl FromRequestParts for Authed  !db !time                           @19-33
    async fn from_request_parts(parts, core) -> Authed fails ApiError  !db !time  @22-32
      -- Resolve the Authorization header to an actor, admin when ADMIN_PUBKEYS lists it.
      fail Unauthorized without an Authorization header
      Unauthorized "authorization must be a bearer token" unless it is "Bearer <token>"
      sessions::find the trimmed token, Unauthorized if none is live
  impl FromRequestParts for Admin  !db !time                            @35-43
    async fn from_request_parts(parts, core) -> Admin fails ApiError  !db !time  @38-42
      -- Authed, then Forbidden unless the actor is an admin.

  pub fn authorization(headers) -> str fails ApiError                   @45-50
    -- The Authorization header as text; Unauthorized when it is missing or not text.
