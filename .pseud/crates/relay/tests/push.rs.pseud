module caravel_relay::tests::push
  -- NIP-9a push, ported from zooid: which subscriptions a relay takes, and the callbacks it makes.

  tests  !panic !lock !spawn !time                                      @25-356
    async fn callback(status) -> (url, receiver)  !panic !lock !spawn   @25-42
      -- A local callback server answering status, passing each body it receives to the receiver.
    fn subscription(server, relay, signer, d, callback, filter) -> Event  @44-67
      -- A kind 30390 for the relay's canonical url with one filter, the callback and include_event.
    async fn member(server, relay, owner) -> SecretKey  -- a new pubkey, allowed by NIP-86  @69-80
    async fn next(receiver) -> Value?  !time  -- the next push within half a second  @82-87
    test a_local_callback_is_refused                                    @91-123
      -- with the real outbound client, a 127.0.0.1 callback is refused at once; a public one is taken
    test the_relay_tag_must_name_this_relay                             @127-155
      -- without the trailing slash or in upper case it is accepted; another host is refused
    test a_pubkey_holds_at_most_ten_subscriptions                       @158-186
      -- the eleventh is "too many subscriptions registered"; replacing one of the ten is accepted
    test a_matching_event_is_pushed_to_other_members                    @189-232
      -- the push carries the event's id, the relay's url and the event
      another kind, and the subscriber's own matching note, are not pushed
    test the_relays_own_events_are_pushed_like_a_members                @236-263
      -- an 8000 after a NIP-86 allowpubkey and an 8001 after a member's leave request are
      -- pushed to the owner's subscription, each signed by the relay
    test an_outsider_is_not_pushed_a_closed_relays_events               @268-309
      -- a non-member's subscription is refused; a member's is pushed until they are removed
    test a_callback_answering_404_drops_its_subscription                @312-356
      -- after one 404, the next note isn't pushed and the 30390 is gone from reads
