  pub data RedirectUrl { url }  -- where the API sends the browser next, such as a Stripe page  @326-329

  data StoredSession { token, expiresAt: ms }  -- a session token kept in this browser  @331-335
  const SESSIONS_KEY = "caravel.sessions"                               @337
  fn readSessions() -> Map<pubkey, StoredSession>  !db  -- the stored sessions; {} when unreadable  @339-345
  fn writeSession(pubkey, session?)  !db  -- store a pubkey's session, or delete it given none  @347-355
  global pendingSessions: Map<pubkey, Promise<StoredSession>>  -- sign-ins in flight  @357
  async fn signIn(current) -> StoredSession  !net !db !time  -- createSession with its signer, then stored  @359-364
  async fn authorization() -> str?  !net !db !time                      @366-381
    -- The signed-in account's bearer token, signing in once when it has none.
    none when signed out
    the account's stored token while it hasn't expired  !time
    else share the pubkey's sign-in in flight or start one, removed from the map once settled
  fn forgetSession()  !db  -- delete the signed-in account's stored session  @383-386
  pub async fn signOut()  !net !db                                      @388-396
    -- End the current account's session on the server, ignoring a failure, and here.
  async fn authed(path, init = {}, failure?) -> Response fails ApiError  !net !db !time  @398-411
    -- Send a request with the account's bearer token, if any.
    get the token first, so a refused sign-in fails without a retry     @403
    on the request's 401 while signed in, forget the session and send once more, signing in again
  async fn callApi<T>(method, path, body?) -> T fails ApiError  !net !db !time  -- authed JSON request, unwrapped  @413-420

