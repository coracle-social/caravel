module caravel_core::domain::policy
  -- A relay's rules as pure functions over its in-memory snapshot, shared by queries and delivery.

  pub const CREATED_AT_UPPER_LIMIT = 300  -- seconds an event may be dated ahead of the clock  @15-16

  impl EventFacts                                                       @18-48
    ~ of, of_head, of_group: kind, the given pubkey, and the room from its room_tag, empty as none  @19-47

  pub fn is_relay_written(kind) -> bool                                 @50-58
    -- Kinds no client may publish: member add, remove and list, roles, and Blossom auth.
  pub const UNREADABLE_KINDS                                            @60-69
    -- Never served: relay and room invites (credentials), join, leave, push subscriptions, Blossom.
  pub fn screen(event, now) -> () fails Refusal                         @71-85
    -- Checks before paying for the signature: invalid if relay-written or dated over 300s ahead.
  pub fn admit_write(snapshot, event, authed: [pubkey], now) -> () fails Refusal  @87-149
    -- Whether a verified event may be published by a connection authenticated as authed.
    check_protected, then screen
    blocked if the event id or its author is banned
    if not a zap receipt or gift wrap p-tagging a manager or member, which anyone may send
      auth-required if nobody is authenticated
      restricted unless the author is authenticated or is the relay's own key
      join requests pass, for their own rules to judge
      push subscriptions return admit_req for the author, so they pass where it could subscribe
      restricted for a non-member unless public_write
    an event carrying its room tag, even empty, goes through check_room_write
  fn check_protected(event, authed) -> () fails Refusal                 @151-177
    -- NIP-70.
    a protected event needs its author authenticated: auth-required if nobody is, else blocked
    a repost whose content JSON carries a "-" tag is blocked
  fn is_for_member(snapshot, event) -> bool  -- a zap receipt or gift wrap p-tagging a member  @179-185
  pub fn check_room_write(snapshot, event) -> () fails Refusal          @187-269
    -- Whether an event may be published into the room machinery.
    invalid when groups are off, for metadata kinds the relay writes, or without a room id
    CREATE_GROUP needs the room not to exist; every other kind needs it to exist
    moderation kinds need can_moderate_room
    for permission assign and unassign, each p tag must list only moderation kinds,
      and a non-manager may only grant or revoke kinds it is permitted in the room
    a hidden room is "group not found" to an author without room access or a valid code tag
    join when already a member, or leave when not, is Unchanged; otherwise both pass
    any other kind in a restricted room needs room access
  pub fn admit_join(snapshot, event) -> Join fails Refusal              @271-304
    -- How a NIP-43 join request is admitted.
    AlreadyMember for a member, before any other check
    blocked if banned; restricted once members reach the plan's member_limit
    Open on a public_join relay
    otherwise Claim with its claim tag, or restricted without one (a paid membership, if it charges)
  pub fn admit_req(snapshot, authed) -> () fails Refusal                @306-327
    -- Whether a connection may open a subscription.
    anonymous: admitted only with anonymous_read, else auth-required
    with public_read, blocked if any authed pubkey is banned
    otherwise restricted unless some authed pubkey has access
  pub fn can_receive(snapshot, reader: pubkey?, event: EventFacts) -> bool  @329-355
    -- Whether a reader may see an event, the one rule stored queries and live delivery share.
    an unauthenticated reader sees nothing without anonymous_read
    a push subscription goes only to its author; UNREADABLE_KINDS to nobody, managers included
    managers see everything else
    room events defer to can_read_room while groups are on
    with groups off they read like any event, hidden and private rooms included  @350
      a test pins this as intended                                      @crates/core/tests/relay_policy.rs:376-385
  fn can_read_room(snapshot, reader, event) -> bool                     @357-378
    a room that doesn't exist shows only DELETE_GROUP
    a hidden room shows nothing to non-members
    metadata and DELETE_GROUP show to all; a private room shows the rest only to members
  pub fn can_any_receive(snapshot, authed, event) -> bool  -- any authed identity, else anonymous  @380-388
  pub fn count_visible(snapshot, authed, groups: [EventGroup]) -> u64   @390-401
    -- NIP-45: the summed counts of the groups can_any_receive admits.
  pub fn can_deliver(snapshot, authed, event) -> bool                   @403-407
    -- admit_req and can_any_receive, so a reader banned or removed mid-subscription stops at once.
  pub fn admit_call(snapshot, pubkey, room_id) -> () fails CallRefusal  @409-427
    -- NotMember off the relay, NoRoom, NoCalls, or NotRoomMember in a private or restricted room.
  pub fn strips_signature(snapshot, authed) -> bool  -- strip_signatures and no authed manager  @429-433
  pub fn is_stored(kind) -> bool  -- anything not ephemeral             @435-438
  pub const MAX_PUSH_SUBSCRIPTIONS = 10  -- per pubkey per relay        @440-441
  pub fn check_push_subscription(event, hosts, held: usize) -> () fails Refusal  @443-500
    -- A well-formed push subscription addressed to this relay; callback reachability is outbound's.
    invalid without a non-empty d tag
    invalid unless the relay tag's url_host is one of hosts
    invalid without a filter tag, or if any filter or ignore tag isn't a valid filter
    invalid unless there is exactly one callback tag, a non-empty http or https url
    invalid once held reaches MAX_PUSH_SUBSCRIPTIONS
