module caravel_api
  -- The headless JSON API for the dashboards and clients such as Flotilla: handlers load what a
  -- request names, authorize the actor against it with the core's rules, then call the core.

  data ReturnTo { return_url? }  -- where a request asks for its caller to be sent back to  @20-22

  pub fn router(core) -> Router  -- every route in routes, at the root of wherever it is mounted  @25-32

  pub fn routes() -> [(path, MethodRouter)]                             @35-151
