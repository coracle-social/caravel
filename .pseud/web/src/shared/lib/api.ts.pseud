  pub data NostrEvent { id, pubkey, created_at, kind, tags, content, sig }  @232-240
  pub type MemberSource = owner | manual | claim | public_join | payment | migrated  @242-243
  pub data RelayMember { pubkey, source, roles: [role id], created_at }  -- a NIP-43 member  @245-251
  pub data RelayRole { id, label, description, hue, position }  -- a NIP-43 kind 33534 role  @253-260
  pub data RelayMembers { members, roles }                              @262-265
  pub data BannedPubkey { pubkey, reason }                              @267
  pub data BannedEvent { id, reason }                                   @268
