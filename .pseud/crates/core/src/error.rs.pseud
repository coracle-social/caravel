module caravel_core::error
  -- The core's error, saying what went wrong in terms the API maps to a response.

  pub type Result<T, E = Error>                                         @6
  pub enum Error                                                        @8-24
    Unauthorized(str)
    Forbidden(static str)
    NotFound(static str)
    Conflict { code, message }  -- the resource's state doesn't allow the operation
    Invalid { code, message }  -- well-formed input that isn't acceptable
    Internal(anyhow)  -- from any anyhow error, displayed transparently

  impl Error                                                            @26-44
    ~ constructors: conflict(code, message), invalid(code, message), internal(message)  @27-43

  impl From<sqlx::Error> for Error  !-db  -- wraps it as Internal; converts, never queries  @46-50
