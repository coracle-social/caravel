module caravel_relay::livekit  !net !db !time !rand
  -- Calls: LiveKit tokens for room members, and the webhook that meters time and lists who's in.

  fn refuse(status, reason) -> Response  -- the status with the reason as its body  @14-16
  pub async fn support(route) -> Response                               @18-25
    -- 204 when the platform has LiveKit and the relay has calls on, else 404.
  pub async fn token(route, room_id, headers) -> Response  !net !time !rand  @27-89
    -- A call token for a member who may see the room, NIP-98-signed for exactly this url.
    404 unless LiveKit is configured and the relay has calls on
    401 unless the header verifies as a GET of https://host/.well-known/nip29/livekit/<room>
      or of the same url over http
    admit_call on the snapshot: 403 not a member, 404 no room, 403 no calls, 403 not in the room
    ensure the LiveKit room named for the relay and room exists; 500 on failure  !net
    sign a participant token for the pubkey's identity, answered with the server url
  pub async fn webhook(relays, headers, body) -> Response  !net !db !time  @91-180
    -- LiveKit's single webhook for every relay's calls; a room's name leads with its relay's id.
    404 without LiveKit; 401 unless receive_webhook verifies the Authorization over the body
    400 without a room; 404 unless its name splits into relay id and room id
    on participant_left or connection_aborted, record_departure first, only logging a failure  !db
      it meters even a relay or room that has lost its calls, whatever follows
    404 unless the relay is served and its snapshot has the room; 403 unless the room has livekit
    room_finished -> no one; joined, left or aborted -> list_participants, 500 on failure  !net
    any other event -> 204
    publish the room's participant list (39004) and broadcast it; 500 on failure
    -- LiveKit queues each room's webhooks and sends the next only once this one has answered,
    -- so runs for one room never overlap (livekit/protocol webhook/resource_queue.go)
