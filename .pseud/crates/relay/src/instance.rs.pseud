  pub data RelayInstance                                                @61-72
    core: Core
    limits: RelayLimits
    state: shared InstanceState  -- swapped whole; readers keep the Arc they took
    reloading: async Mutex  -- held across a reload's reads, so older state can't replace newer
    connections: Connections
    pusher: Pusher  -- shared by every instance
    closed: CancellationToken  -- cancelled when the relay stops being served

