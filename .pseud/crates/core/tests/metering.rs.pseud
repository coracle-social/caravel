module caravel_core::tests::metering
  -- Overage from what the hourly sampler measures (stored blobs, call time); one test per binary.

  tests  !db !time                                                      @12-105
    async fn upload(core, relay_id, sha256, size, pubkey) fails  !db !time  -- media record_upload, now  @12-21
    async fn delete(core, relay_id, sha256, pubkey) fails  !db  -- commands::media::delete_upload  @23-28
    async fn call(core, relay_id, sid, hours) fails  !db !time  -- record a finished call session of hours  @30-42
    test overage_is_billed_from_measured_media_and_calls                @45-105
      -- A blob two members upload is stored once; storage bills its peak (3.2 GB rounds to 4,
      -- $6 past Basic's 1) even after deletion; call hours accumulate (40 is $1 past 30);
      -- the free relay's uploads are not metered at all.
