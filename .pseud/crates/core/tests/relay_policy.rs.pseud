    test a_gift_wrap_or_zap_for_a_member_needs_no_authentication        @113-137
      -- Only when the p tag names a member.
    test events_dated_too_far_ahead_are_refused  -- CREATED_AT_UPPER_LIMIT itself is allowed  @140-154
    test kinds_the_relay_writes_itself_are_refused                      @157-173
      -- Add/remove member, member list, role and Blossom auth, even from the owner.
    test banned_authors_and_events_are_blocked                          @176-197
    test a_protected_event_is_published_only_by_its_authenticated_author  @200-228
      -- A "-" event needs its author authenticated, and a repost of one is blocked.
    test reading_needs_authentication_unless_anonymous_reads_are_on     @231-246
    test a_private_relay_is_read_only_by_its_members                    @249-273
      -- One member key among several suffices; public_read admits anyone not banned.
    fn pubkey_of_nobody() -> str  -- a fresh random pubkey              @275-277
    fn rooms_fixture(f) -> RelaySnapshot                                @281-316
      -- Groups and anonymous reads on, with open, private, hidden, closed (invite "sesame") and
