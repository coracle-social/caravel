module caravel_db  !db !time
  -- Postgres for every layer above: the pool, the migrations, and transactions that retry.

  ~ declares testing, behind the "testing" feature                      @9-10
  pub data Db { pool: PgPool }  -- the app opens one for requests and one for workers  @14-17
  pub interface Retryable  -- an error Postgres raised to resolve a conflict, not a mistake  @21-23
    fn is_retryable(self) -> bool                                       @22
  impl Retryable for sqlx::Error  !-db  -- names sqlx::Error, reads no database  @25-30
    fn is_retryable(self) -> bool  -- SQLSTATE 40001 serialization_failure or 40P01 deadlock  @26-29

  impl Db  !db !time                                                    @32-80
    pub async fn connect(url, max_connections: u32) -> Db fails sqlx::Error  !db  @34-42
      -- A pool of at most max_connections, waiting at most 10s to acquire a connection.
    pub async fn migrate(self) fails MigrateError  !db  -- run the migrations embedded at compile time  @45-47
    pub fn pool(self) -> PgPool                                         @49-51
    pub async fn with_tx(self, f) -> T fails E  !db !time               @56-79
      -- Run f in a transaction and commit; a conflict reruns it on a fresh clone of f.
      -- So f must have no effects outside the database.
      loop
        begin, run f, and commit if it succeeded; a failed f rolls back when the transaction drops
        if the error from f or the commit is_retryable and fewer than 4 retries have run
          sleep 20, 40, 80 then 160ms and run again  !time
        else return the result

  fn sqlstate(error) -> str?  !-db  -- a database error's SQLSTATE code  @83-88
  pub fn unique_violation(error) -> str?  !-db  -- the violated unique constraint's name, if that's it  @91-96
