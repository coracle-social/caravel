module caravel_api::auth  !db !time
  -- Extractors that authenticate a request: a handler taking one requires it; without one, public.

  pub data Authed(Actor)  -- the actor behind a session token, or a legacy NIP-98 header  @15
  pub data Admin  -- proof that the request is from a platform admin    @18

  impl FromRequestParts for Authed  !db !time                           @20-39
    async fn from_request_parts(parts, core) -> Authed fails ApiError  !db !time  @23-38
      -- Resolve the Authorization header to an actor, admin when ADMIN_PUBKEYS lists it.
      fail Unauthorized without an Authorization header
      "Bearer <token>" -> sessions::find the trimmed token, Unauthorized if none is live
      anything else -> a NIP-98 header signed for the API's base url, checked at now
  impl FromRequestParts for Admin  !db !time                            @41-49
    async fn from_request_parts(parts, core) -> Admin fails ApiError  !db !time  @44-48
      -- Authed, then Forbidden unless the actor is an admin.

  pub fn authorization(headers) -> str fails ApiError                   @51-56
    -- The Authorization header as text; Unauthorized when it is missing or not text.
