module @/shared/components/PostPaidPrompts  !net !db !time
  -- After a paid plan is picked, prompting a tenant without autopay to pay and then set it up.

  type Step = idle | starting | pay(invoice) | setup                    @10-14
  pub fn usePostPaidFlow() -> { step, setStep, start }  !net !db !time  @18-46
    -- The flow's step. While it isn't idle, billingFlowActive is set, which quiets the billing
    -- banner and stops autopayBilling charging; unmounting clears it.
    fn start() -> bool  !net !db !time  -- whether the tenant is now being prompted  @25-43
      reconcile the tenant; if autopay is configured, go idle and return false
      pick the newest open invoice with a nonzero amount, by period_start  @35-36
      step to paying it, or to setup when there is none, and return true
      on failure go idle and rethrow
  type PostPaidFlow = the return of usePostPaidFlow                     @48
  pub fn PostPaidPrompts(props: { flow: PostPaidFlow, onDone? })  !net !db !time  @50-81
    -- The flow's dialogs: PaymentDialog for its invoice, then PaymentSetup.
    the payment dialog doesn't offer setup itself, since setup is the flow's next step  @63
    closing the payment dialog refetches billing and steps to setup     @64-67
    closing setup goes idle, refetches billing and calls onDone         @73-77
