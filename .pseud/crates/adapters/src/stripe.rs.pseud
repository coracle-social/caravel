    customer_id, subscription_id, membership_id: str?
  pub data Subscription                                                 @522-533
    current_period_end: i64?
    cancel_at_period_end: bool
    in_good_standing: bool  -- active or trialing; Stripe moves the period on before collecting
    past_due: bool  -- a payment failed and Stripe is retrying it
    latest_invoice_paid: bool  -- a renewal's invoice is a draft for an hour, then open until paid
