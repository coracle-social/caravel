module caravel_adapters::nostr  !net !time !rand
  -- A client for other people's Nostr relays: publish, fetch, and request-reply (as NIP-47 asks).
  -- Every call opens its own connections, closes them when done, and answers NIP-42 challenges.

  const CLIENT_AUTH = 22242  -- the kind of a NIP-42 answer             @27
  pub data Client { secret: SecretKey, allow_private: bool }  -- the key to talk to relays as  @30-34

  impl Client  !net !time !rand                                         @36-281
    pub fn new(secret) -> Client  -- one refusing relays on local or internal addresses  @37-42
    pub fn allowing_private(secret) -> Client  -- also reaches loopback, for tests  @45-50
    pub async fn publish(self, relays, event, now, timeout) fails  !net !time  @53-75
      -- Publish to every relay at once, each within timeout; succeed if any took it.
      waits for every relay to finish or time out, then fails with all their errors if none took it
    pub async fn fetch(self, relays, filter, now, timeout) -> [Event] fails  !net !time !rand  @79-107
      -- Events matching filter from every relay at once, deduplicated by id.
      run fetch_from on each relay with timeout
      fail only when relays is non-empty and every relay failed
      return the union, ordered by event id
    pub async fn request(self, relays, event, reply: Filter, now, timeout) -> Event fails  !net !time !rand  @111-126
      -- The first verified event matching reply from any relay; fails with no relays or all failing.
      race request_from on every relay, each within timeout, taking the first success
    async fn publish_to(self, relay, event, now) fails  !net            @128-158
      -- Send EVENT and wait for its OK, resending once after an auth-required refusal.
      open a connection and send EVENT
      loop on messages
        a challenge answered -> resend if a refusal was waiting for it
        OK for another id or another message -> ignore
        OK true -> close and succeed
        OK false -> Retry decides: resend now, keep waiting for a challenge, or fail with the reason
    async fn fetch_from(self, relay, filter, now, timeout) -> [Event] fails  !net !time !rand  @162-217
      -- REQ under a random id until EOSE or timeout, keeping verified events that match filter,
      -- then CLOSE; fails at the timeout only if the relay has sent none.
      a CLOSED for the subscription goes through Retry like publish_to's refusals
      messages for other subscriptions are ignored
    async fn request_from(self, relay, event, reply, now) -> Event fails  !net !rand  @221-280
      -- Subscribe to reply, publish the request once the subscription is open, and wait for an
      -- answer; one sent before then is missed, since a relay forwards it only to open ones.
      send REQ under a random id, and EVENT only at its first EOSE
      CLOSED on the subscription -> its own Retry: resend REQ, wait for a challenge, or fail
      OK false for the request -> its own Retry: resend EVENT, wait for a challenge, or fail
      a challenge answered -> resend whichever was waiting for it
      EVENT on the subscription that verifies and matches -> close and return it

  fn within(timeout, work) -> T fails  !time  -- work's result, or an error after timeout  @284-288
  fn verified(value) -> Event?  -- the value as an event, if it parses and its signature holds  @291-294
  data Retry  -- whether to resend after a refusal, at most once        @298-303
    retried: bool
    waiting: bool  -- refused for want of auth before the relay challenged
  impl Retry                                                            @305-320
    fn on_refused(mut self, reason, authenticated) -> bool              @307-314
      -- Resend now only for a first auth-required refusal on an authenticated connection.
      -- Unauthenticated, it sets waiting so the resend happens after the challenge.
    fn on_authenticated(mut self) -> bool  -- take waiting: resend now if a refusal was waiting  @317-319
  enum Received = Authenticated | Message(Value)  -- Authenticated: a challenge was answered  @322-326
  data Connection { socket, relay, secret, now, authenticated }  -- one websocket  @329-335

  impl Connection  !net                                                 @337-416
    async fn open(relay, secret, now, allow_private) -> Connection fails  !net  @338-361
      -- Connect over TLS trusting the Mozilla roots, dialing through outbound::connect, so a relay
      -- on a local or internal address, however it is named, is refused unless allow_private.
    async fn send(mut self, message) fails  !net  -- one text frame of message's JSON  @363-368
    async fn receive(mut self) -> Received fails  !net                  @371-395
      -- The next JSON text message, answering an AUTH challenge itself.
      skip non-text frames and unparseable text; fail when the socket ends
      on ["AUTH", challenge] send answer(challenge) and return Authenticated
        -- marked authenticated without waiting for the relay's OK to the answer
    fn answer(self, challenge) -> Event  -- a signed kind 22242 with relay and challenge tags at now  @398-411
    async fn close(self)  !net  -- close the socket, ignoring errors    @413-415

  fn tls() -> Connector  !-panic  -- the expect is unreachable: ring supports the default versions  @419-430
    -- rustls over ring, trusting the webpki (Mozilla) roots.

  tests                                                                 @432-562
    ~ a relay without EOSE by the timeout keeps what it sent; one that sent nothing didn't answer
    ~ a relay on 127.0.0.1 or localhost is refused before it is dialed
    ~ a request whose REQ is closed for want of auth subscribes again, then publishes
