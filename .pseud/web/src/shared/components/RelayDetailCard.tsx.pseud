module @/shared/components/RelayDetailCard  !net
  -- The body of a relay's page, shared by the tenant and admin dashboards.

  fn DetailSection(props: { title })  -- a titled two-column definition list  @20-29
  fn MembershipSection(props: { title })  -- a titled definition list   @31-40
  data Toggle                                                           @43-48
    flag: RelayFlag
    label
    planGated?  -- on a free plan, asks to upgrade instead
    requires?: RelayFlag  -- shown only while this flag is on
  const POLICY_TOGGLES                                                  @50-56
    public read, public write, public join, members can invite, strip signatures
  const FEATURE_TOGGLES                                                 @58-65
    rooms, management API, push notifications
    media storage (blossom_enabled) and LiveKit, both plan-gated
    members-only media (blossom_authenticated_read), shown only while media storage is on
  type Action = deactivate | reactivate | erase | purge                 @67
  fn confirmation(action, label) -> Confirmation                        @69-123
    -- What each action asks before it runs, listing what it deletes and keeps.
    purge -> delete everything, freeing the subdomain, with a prorated credit for a paid relay
    erase -> delete data, unpaid invites and members but the owner and payers, keeping settings
    deactivate -> take it offline, keeping everything; reactivate -> bring it back online
  type RelayDetailCardProps  -- the relay, member count, action handlers and display switches  @125-140
  pub fn RelayDetailCard(props: RelayDetailCardProps)  !net             @142-362
    -- A relay's header and menu, custom domain, policy and feature switches, membership,
    -- member payments and plan.
    planLimited when enforcePlanLimits (default on) and the relay is on FREE  @159
    a switch calls onToggle; a plan-gated one on a limited plan is a PlanGatedToggle  @194-212
    an unverified custom domain shows the CNAME to add and a verify button rereading the relay  @254-280
    the member limit is the plan's, ∞ when unlimited, ? when the plan is unknown  @154-158
    member payments show only with mutateRelay; the plan only with showPlanActions  @322-352
    with onUpdatePlan the plan is picked in a selectable PricingTable, else just named  @335-350
      the selection is the relay's plan_id, which onUpdatePlan's optimistic copy moves  @346
    changePlanId: await onUpdatePlan, toast success; a failure is the caller's to report  @163-170
    a menu action opens its ConfirmDialog; confirming awaits the handler, then closes it  @177-192
