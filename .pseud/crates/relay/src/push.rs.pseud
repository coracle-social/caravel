module caravel_relay::push  !net !db !lock !spawn !time
  -- NIP-9a push: stored kind 30390 subscriptions, and a bounded pool POSTing new event ids to them.

  const WORKERS = 16  -- deliveries running at once                     @19-20
  const QUEUE = 4096  -- deliveries waiting before new ones are dropped  @22-23
  const MAX_FAILURES = 10  -- failures in a row that drop a subscription  @25-26
  const MAX_SUBSCRIPTIONS = 100_000  -- the most read for one relay     @28-29
  pub data Subscription                                                 @31-41
    -- A stored push subscription, parsed.
    id: EventId
    pubkey, d, callback: str
    filters, ignore: [Filter]
    include_event: bool
  impl Subscription                                                     @43-64
    fn parse(stored) -> Subscription?                                   @44-63
      -- From its tags; needs d and callback, and skips filter and ignore tags that aren't filters.
  pub async fn load_subscriptions(core, relay_id) -> [Subscription] fails  !db !time  @66-85
    -- Up to MAX_SUBSCRIPTIONS of the relay's unexpired kind 30390 events, dropping unparseable ones.
  pub fn held_by(subscriptions, event) -> usize                         @87-95
    -- How many subscriptions the author holds besides the one this event's d replaces.
  data Delivery { relay_id, subscription: EventId, callback, payload: Value }  @97-103
  pub data Pusher                                                       @105-111
    -- The delivery queue and each subscription's run of failures; clones share both.
    sender: mpsc::Sender<Delivery>  -- bounded at QUEUE
    failures: shared Map<(relay_id, EventId), u32>

  impl Pusher  !net !db !lock !spawn                                    @113-241
    pub fn start(core, shutdown) -> Pusher  !lock !spawn                @114-141
      -- Spawn WORKERS tasks sharing one receiver, each delivering until shutdown or the queue closes.
    pub fn push(self, snapshot, subscriptions, primary_host, event)     @143-186
      -- Queue a delivery for each subscription the event should reach.
      for each subscription
        skip the event's author, a reader can_deliver refuses, no filter match, or an ignore match
        the payload is the event id and wss://primary_host/
        with include_event, add the event, stripped if strips_signature for the subscriber
        try_send; a full queue drops the delivery with a warning
    pub fn retain(self, relay_id, held: [Subscription])  !lock          @188-194
      -- Forget the relay's failure counts but held's, once the rest are replaced, deleted or expired.
      -- An instance calls it on each install with its new subscriptions, and on removal with none.
    async fn deliver(self, core, delivery)  !net !db !lock              @196-234
      -- POST the payload to the callback and track how it went.
      2xx -> clear the subscription's failure count
      404 -> clear it and drop the subscription
      anything else, a transport error included -> count it; at MAX_FAILURES clear it and drop
      dropping deletes the subscription's event, reloading the relay over the bus; failure is logged
    fn failures(self) -> lock guard  !lock  -- the counts, recovering a poisoned lock  @236-240

  tests                                                                 @243-279
    ~ retain forgets only the named relay's counts for subscriptions it no longer holds
