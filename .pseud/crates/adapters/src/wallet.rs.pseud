module caravel_adapters::wallet  !net !rand
  -- Nostr Wallet Connect (NIP-47) over a wallet's relays, NIP-04 encrypted.

  const TIMEOUT = 60s  -- waiting for the wallet to answer              @25
  ~ kinds REQUEST 23194, RESPONSE 23195                                 @27-28
  pub data Wallet  -- the platform's wallet, which issues invoices, or a tenant's, which pays them  @32-38
    wallet: PublicKey; relays: [url]; secret: SecretKey; client: nostr::Client
  data Response { result: Value?, error: ResponseError? }               @41-47
  data ResponseError { code: str, message: str }                        @49-53

  impl Wallet  !net !rand                                               @55-160
    pub fn from_url(url) -> Wallet fails                                @56-83
      -- Parse nostr+walletconnect://<wallet pubkey>?relay=…&secret=…, needing a secret and a relay.
      -- Its relays are dialed by a nostr::Client that refuses local and internal addresses.
    pub async fn make_invoice(self, amount_msats: u64, description, expiry_secs, now) -> str fails  !net !rand  @86-106
      -- make_invoice, returning the bolt11 the wallet answers with.
    pub async fn pay_invoice(self, bolt11, now) fails  !net !rand  -- pay_invoice; the result is ignored  @108-112
    pub async fn is_settled(self, bolt11, now) -> bool fails  !net !rand  @115-121
      -- lookup_invoice: settled when state is "settled" or settled_at is set.
    async fn call(self, method, params, now) -> Value fails  !net !rand  @124-159
      -- Ask the wallet to run method and return its result.
      sign a kind 23194 at now, p-tagged to the wallet, with {method, params} NIP-04 encrypted
      Client::request it on every relay, waiting TIMEOUT for a 23195 from the wallet e-tagging it
      decrypt and parse the answer; fail on its error as "code: message", or on no result

  ~ Encryptor, Decryptor: AES-256-CBC                                   @162-163
  fn nip04_encrypt(secret, peer, plaintext) -> str  !rand               @166-172
    -- AES-256-CBC under the raw ECDH secret with a random IV, as "<base64>?iv=<base64>".
  fn nip04_decrypt(secret, peer, payload) -> str fails                  @174-188
    -- The inverse; fails on a malformed payload, an IV that isn't 16 bytes, bad padding or non-UTF-8.

  tests                                                                 @190-237
    ~ NIP-04 round-trips between two keys; a wallet url yields its wallet, relays and secret
    ~ a wallet whose relay is on a local address fails without dialing it
